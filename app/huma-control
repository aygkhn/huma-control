    def _on_language(self, row, _p):
        code = LANGUAGES[row.get_selected()][0]
        if code == app_language():
            return
        try:
            APP_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
            APP_SETTINGS.write_text(json.dumps({'language': code}))
        except OSError as e:
            self.toast(str(e))
            return
        # restart in the new language, on the same page
        os.environ.pop('LANGUAGE', None)
        os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), '--page', 'about'])

