    def _on_curve_base(self, row, _p):
        if self.curve_editor.set_base(row.get_value()) != row.get_value():
            # can't exceed the first point's duty: clamp the row too (equal on the re-entrant call)
            row.set_value(self.curve_editor.base)
            return
        self._curve_dirty = True

    def _on_curve_switch(self, row, _p):
        if self._updating:
            return
        if row.get_active():
            self._apply_curve()
        else:
            self._run_root_async([HELPER, 'fan-curve', 'auto'], _('Fan curve: Monster Control Center tables'))

