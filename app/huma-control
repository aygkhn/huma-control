def helper_error(text):
    """A helper's error text in the user's language (unknown texts as written), line by line."""
    def one(line):
        line = line.strip()
        if line in HELPER_ERRORS:
            return HELPER_ERRORS[line]
        for prefix, template in HELPER_ERROR_PREFIXES:
            if line.startswith(prefix):
                return template.format(error=one(line[len(prefix):]))
        return line
    return '\n'.join(one(line) for line in text.strip().splitlines())

