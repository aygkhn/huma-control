class FanCurveEditor(Gtk.DrawingArea):
    """Fan curve: x = temperature (30–90 °C), y = fan duty (0–100%). Points are draggable.

    The controller applies the curve as steps: when the temperature passes a point the fan
    rises to that point's duty, and drops back to the previous step a few degrees lower.
    Safety (the driver checks too): points are between 30 and 85 °C and increasing, duty
    never decreases, the first point is at 70 °C at the latest and at least 20% (so the fan
    doesn't sit still until things get hot), and the last point is 100%.
    """
    T0, T1 = 30, 90
    PAD_L, PAD_R, PAD_T, PAD_B = 42, 14, 12, 26

    def __init__(self, on_change):
        super().__init__(content_height=250, hexpand=True, margin_top=6, margin_bottom=6)
        self.points = [list(p) for p in FAN_PRESETS['balanced'][1]]
        self.base = FAN_PRESETS['balanced'][0]
        self.on_change = on_change
        self._drag = None
        self.set_draw_func(self._draw)
        drag = Gtk.GestureDrag()
        drag.connect('drag-begin', self._begin)
        drag.connect('drag-update', self._update)
        drag.connect('drag-end', lambda *_: setattr(self, '_drag', None))
        self.add_controller(drag)
        self.set_cursor(Gdk.Cursor.new_from_name('pointer'))

    # --- coordinate conversion
    def _area(self):
        w, h = self.get_width(), self.get_height()
        return self.PAD_L, self.PAD_T, w - self.PAD_L - self.PAD_R, h - self.PAD_T - self.PAD_B

    def _xy(self, t, d):
        x, y, w, h = self._area()
        return x + w * (t - self.T0) / (self.T1 - self.T0), y + h * (1 - d / 100)

    def _td(self, px, py):
        x, y, w, h = self._area()
        return self.T0 + (px - x) / w * (self.T1 - self.T0), (1 - (py - y) / h) * 100

    # --- dragging
    def _begin(self, _g, px, py):
        best, dist = None, 18
        for i, (t, d) in enumerate(self.points):
            x, y = self._xy(t, d)
            if abs(x - px) + abs(y - py) < dist:
                best, dist = i, abs(x - px) + abs(y - py)
        self._drag = best

    def _update(self, g, dx, dy):
        if self._drag is None:
            return
        _ok, sx, sy = g.get_start_point()
        t, d = self._td(sx + dx, sy + dy)
        i, pts = self._drag, self.points
        lo_t = pts[i - 1][0] + 2 if i > 0 else 30
        hi_t = pts[i + 1][0] - 2 if i + 1 < len(pts) else 85
        lo_d = pts[i - 1][1] if i > 0 else max(self.base, 20)
        if i == 0:
            hi_t = min(hi_t, 70)
        hi_d = pts[i + 1][1] if i + 1 < len(pts) else 100
        pts[i][0] = int(round(min(max(t, lo_t), hi_t)))
        pts[i][1] = 100 if i == len(pts) - 1 else int(round(min(max(d, lo_d), hi_d) / 5) * 5)
        self.queue_draw()
        self.on_change()

    # --- editing
    def set_preset(self, name):
        base, pts = FAN_PRESETS[name]
        self.base, self.points = base, [list(p) for p in pts]
        self.queue_draw()

    def set_base(self, value):
        """Can't exceed the first point's duty; returns the value applied."""
        self.base = min(int(value), self.points[0][1])
        self.queue_draw()
        return self.base

    def add_point(self):
        if len(self.points) >= 10:
            return
        gaps = [(self.points[i + 1][0] - self.points[i][0], i) for i in range(len(self.points) - 1)]
        gap, i = max(gaps) if gaps else (0, -1)
        if gap < 5:
            return
        a, b = self.points[i], self.points[i + 1]
        self.points.insert(i + 1, [(a[0] + b[0]) // 2, (a[1] + b[1]) // 2 // 5 * 5])
        self.queue_draw()

    def remove_point(self):
        if len(self.points) > 2:
            del self.points[-2]
            self.queue_draw()

    def table(self):
        """The 48 numbers the driver expects: 16 rising thresholds, 16 falling thresholds, 16 duties (% × 2)."""
        n = len(self.points)
        up = [t for t, _ in self.points] + [255] * (16 - n)
        down = [0] + [max(20, self.points[0][0] - 8)] + [t - 3 for t, _ in self.points[1:]] + [255] * (15 - n)
        duty = [self.base * 2] + [d * 2 for _, d in self.points]
        duty += [duty[-1]] * (16 - len(duty))
        return up + down + duty

    def set_table(self, nums):
        up, duty = nums[:16], nums[32:]
        # the driver accepts at most 15 points (up[15] is always 255): the 16th rising threshold has no duty
        n = next((i for i, v in enumerate(up) if v == 255), 15)
        if n < 1:
            return
        self.base = duty[0] // 2
        self.points = [[up[i], duty[i + 1] // 2] for i in range(n)]
        self.points[-1][1] = 100
        self.queue_draw()

    # --- drawing
    def _draw(self, _area, cr, w, h):
        fg = self.get_color()
        x0, y0, gw, gh = self._area()
        accent = Adw.StyleManager.get_default().get_accent_color_rgba()
        cr.set_line_width(1)
        cr.select_font_face('Sans')
        cr.set_font_size(10)
        for t in range(30, 91, 10):
            x = self._xy(t, 0)[0]
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .08)
            cr.move_to(x, y0)
            cr.line_to(x, y0 + gh)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .5)
            cr.move_to(x - 9, h - 8)
            cr.show_text(f'{t}°')
        for d in (0, 25, 50, 75, 100):
            y = self._xy(30, d)[1]
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .08)
            cr.move_to(x0, y)
            cr.line_to(x0 + gw, y)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .5)
            cr.move_to(4, y + 3)
            cr.show_text(pct(d))
        # 85 °C limit
        x85 = self._xy(85, 0)[0]
        cr.set_source_rgba(0.88, 0.11, 0.14, .35)
        cr.set_dash([4, 4])
        cr.move_to(x85, y0)
        cr.line_to(x85, y0 + gh)
        cr.stroke()
        cr.set_dash([])
        # stepped curve
        steps = [(self.T0, self.base)] + [(t, d) for t, d in self.points]
        cr.move_to(*self._xy(self.T0, self.base))
        for i, (t, d) in enumerate(steps[1:], start=1):
            cr.line_to(*self._xy(t, steps[i - 1][1]))
            cr.line_to(*self._xy(t, d))
        cr.line_to(*self._xy(self.T1, 100))
        cr.set_source_rgba(accent.red, accent.green, accent.blue, 1)
        cr.set_line_width(2.5)
        cr.stroke_preserve()
        cr.line_to(*self._xy(self.T1, 0))
        cr.line_to(*self._xy(self.T0, 0))
        cr.close_path()
        cr.set_source_rgba(accent.red, accent.green, accent.blue, .12)
        cr.fill()
        for i, (t, d) in enumerate(self.points):
            x, y = self._xy(t, d)
            cr.new_path()   # don't draw a line from the previous label to the circle
            cr.arc(x, y, 7 if i == self._drag else 6, 0, 6.2832)
            cr.set_source_rgba(1, 1, 1, 1)
            cr.fill_preserve()
            cr.set_source_rgba(accent.red, accent.green, accent.blue, 1)
            cr.set_line_width(2.5)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .8)
            cr.move_to(x - 16, y - 12)
            cr.show_text(f'{t}° {pct(d)}')


class HistoryChart(Gtk.DrawingArea):
    """Single-series chart with a time axis (History page)."""

    def __init__(self, unit, rgba, fixed=None):
        super().__init__(content_height=120, hexpand=True)
        self.unit, self.rgba, self.fixed = unit, rgba, fixed
        self.times, self.values, self.span = [], [], (0, 1)
        self.set_draw_func(self._draw)

    def set_data(self, times, values, span):
        self.times, self.values, self.span = times, values, span
        self.queue_draw()

    def _draw(self, _area, cr, w, h):
        fg = self.get_color()
        pad_l, pad_b, pad_t = 44, 18, 8
        gw, gh = w - pad_l - 8, h - pad_b - pad_t
        vals = [v for v in self.values if v is not None]
        lo, hi = self.fixed or ((min(vals), max(vals)) if vals else (0, 1))
        if hi - lo < 1e-6:
            hi = lo + 1
        cr.set_font_size(10)
        cr.set_line_width(1)
        for frac in (0, .5, 1):
            y = pad_t + gh * (1 - frac)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .08)
            cr.move_to(pad_l, y)
            cr.line_to(pad_l + gw, y)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .5)
            cr.move_to(2, y + 3)
            cr.show_text(f'{lo + (hi - lo) * frac:.0f}{self.unit}')
        t0, t1 = self.span
        # beyond 12 hours the time alone is ambiguous (yesterday or today?): show the date too
        if t1 - t0 <= 12 * 3600:
            fmt = '%H:%M'
        elif t1 - t0 <= 2 * 86400:
            # Translators: strftime format for chart labels (day, month and time)
            # xgettext: no-python-format
            fmt = _('%m/%d %H:%M')
        else:
            # Translators: strftime format for chart labels (day and month)
            # xgettext: no-python-format
            fmt = _('%m/%d')
        from datetime import datetime as _dt
        for frac in (0, .5, 1):
            text = _dt.fromtimestamp(t0 + (t1 - t0) * frac).strftime(fmt)
            cr.move_to(pad_l + gw * frac - cr.text_extents(text).x_advance * frac, h - 3)
            cr.show_text(text)
        if not vals:
            cr.move_to(pad_l + gw / 2 - 40, pad_t + gh / 2)
            cr.show_text(_('No records yet'))
            return
        cr.set_source_rgba(*self.rgba)
        cr.set_line_width(1.8)
        prev = None
        gap = max(600, (t1 - t0) / 150)   # break the line where records are missing (while powered off)
        for t, v in zip(self.times, self.values):
            if v is None:
                prev = None
                continue
            x = pad_l + gw * (t - t0) / max(t1 - t0, 1)
            y = pad_t + gh * (1 - (min(max(v, lo), hi) - lo) / (hi - lo))
            if prev is None or t - prev > gap:
                cr.move_to(x, y)
            else:
                cr.line_to(x, y)
            prev = t
        cr.stroke()


