def stage_anchors(dark, very_dark, sun):
    """Measurement values of the levels (stageAnchors in the extension)."""
    dark = min(dark, 150)
    return [min(very_dark, dark), dark, min(dark * 1.5, 254), 255, max(sun, 256)]


def nearest_stage(value, anchors):
    level = lambda v: math.log1p(max(v, 0))
    return min(range(len(anchors)), key=lambda i: abs(level(value) - level(anchors[i])))


def screen_percent():
    """Current brightness of the laptop panel (%)."""
    for dev in Path('/sys/class/backlight').glob('*'):
        try:
            return round(100 * int((dev / 'brightness').read_text()) / int((dev / 'max_brightness').read_text()))
        except (OSError, ValueError, ZeroDivisionError):
            continue
    return None


