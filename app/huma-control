        self._generation = 0   # bumped when a command starts and ends; stale reads aren't applied to the controls
        # the extension (Quick Settings) also changes keyboard.json: reflect changes in the controls
        self._kbd_monitor = Gio.File.new_for_path(str(KBD_CONFIG)).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self._kbd_monitor.connect('changed', lambda *_: self._reload_kbd_later())
        self._kbd_reload_timer = 0
        self._sync_kbd_texts(force=True)
        self.refresh(True)   # first read is full (so settings load even if the window opens in the background)
        self._timer = GLib.timeout_add_seconds(2, self.refresh)
        # the driver reports mode key, Fan Boost and curve changes with a udev event
        if GUdev:
            self._udev = GUdev.Client(subsystems=['platform'])
            self._udev.connect('uevent', lambda _c, action, dev: action == 'change' and
                               dev.get_name() == 'qc71_laptop' and GLib.idle_add(lambda: self.refresh(True) and False))
        # refresh right away when focused or restored from minimized
        for prop in ('notify::is-active', 'notify::suspended'):
            self.connect(prop, lambda *_: self.is_active() and not self.is_suspended() and self.refresh(True))
        GLib.timeout_add_seconds(3, lambda: self._sync_location() and False)
        self.connect('close-request', lambda *_: GLib.source_remove(self._timer) and False)

    def toast(self, text):
