class Graph(Gtk.DrawingArea):
    """History of CPU temperature (accent color) and fan speed (orange)."""

    def __init__(self, temps, rpms):
        super().__init__(content_height=170, hexpand=True)
        self.temps, self.rpms = temps, rpms
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, w, h):
        fg = self.get_color()
        pad_l, pad_b, pad_t = 34, 18, 8
        gw, gh = w - pad_l - 6, h - pad_b - pad_t
        # horizontal grid lines and temperature axis (30-100 °C)
        cr.set_line_width(1)
        cr.select_font_face('Sans')
        cr.set_font_size(10)
        for t in (40, 60, 80, 100):
            y = pad_t + gh * (1 - (t - 30) / 70)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .08)
            cr.move_to(pad_l, y)
            cr.line_to(pad_l + gw, y)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .45)
            cr.move_to(4, y + 3)
            cr.show_text(f'{t}°')
        cr.set_source_rgba(fg.red, fg.green, fg.blue, .45)
        cr.move_to(pad_l, h - 4)
        cr.show_text(_('3 min ago'))
        now = _('now')
        cr.move_to(pad_l + gw - max(22, cr.text_extents(now).x_advance), h - 4)
        cr.show_text(now)

        def line(values, scale, rgba, fill):
            pts = [(pad_l + gw * i / (HISTORY - 1), pad_t + gh * (1 - min(max(scale(v), 0), 1)))
                   for i, v in enumerate(values, start=HISTORY - len(values)) if v is not None]
            if len(pts) < 2:
                return
            cr.set_source_rgba(*rgba)
            cr.set_line_width(2.4)
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            if fill:
                cr.stroke_preserve()
                cr.line_to(pts[-1][0], pad_t + gh)
                cr.line_to(pts[0][0], pad_t + gh)
                cr.close_path()
                cr.set_source_rgba(rgba[0], rgba[1], rgba[2], .12)
                cr.fill()
            else:
                cr.stroke()

        accent = Adw.StyleManager.get_default().get_accent_color_rgba()
        line(self.rpms, lambda v: v / 5000, (1.0, .56, .24, .95), False)
        line(self.temps, lambda v: (v - 30) / 70, (accent.red, accent.green, accent.blue, 1), True)


