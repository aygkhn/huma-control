    if seconds < 3600:
        return ngettext('{n} minute', '{n} minutes', seconds // 60).format(n=seconds // 60)
    return ngettext('{n} hour', '{n} hours', seconds // 3600).format(n=seconds // 3600)


def days_label(days):
