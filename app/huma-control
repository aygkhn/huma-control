    def _kbd_values(self):
        """Values of the keyboard.json fields from the controls (computed lazily)."""
        return {
            'idle_timeout_s': lambda: TIMEOUTS[self.timeout_row.get_selected()][0],
            'off_in_daytime': self.daytime_row.get_active,
            'dark_turn_on': self.dark_row.get_active,
            'dark_threshold': lambda: int(self.threshold_row.get_value()),
            'very_dark_threshold': lambda: int(min(self.very_dark_row.get_value(), self.threshold_row.get_value())),
            'screen_sensitivity': lambda: self.sensitivity_row.get_selected() + 1,
            'osd': self.osd_row.get_active,
            'sun_full': self.sun_full_row.get_active,
            'sun_threshold': lambda: int(self.sun_row.get_value()),
            'screen_method': lambda: 'stages' if self.method_row.get_selected() == 0 else 'relative',
            'screen_stages': lambda: [int(r.get_value()) for r in self.stage_rows],
            'presence': self.presence_row.get_active,
            'battery_only': self.battery_only_row.get_active,
            'presence_s': lambda: PRESENCE_DELAYS[self.presence_delay_row.get_selected()][0],
            'presence_camera': lambda: 'normal' if self.presence_camera_row.get_selected() == 1 else 'auto',
            'screen_auto': self.screen_row.get_active,
            'measure_interval_s': lambda: LIGHT_INTERVALS[self.interval_row.get_selected()][0],
        }

    def _save_kbd(self, done_text, *keys):
        """Writes only the changed keyboard/ambient light settings: the helper merges them into the
        existing file, so changes made meanwhile by the extension (Quick Settings) aren't lost."""
        values = self._kbd_values()
        self._write_kbd({key: values[key]() for key in keys}, done_text)

    def _write_kbd(self, changes, done_text):
        data = json.dumps(changes)
        self._begin()
        self._kbd_saving += 1

        def worker():
            result = subprocess.run(['pkexec', HELPER, 'keyboard-set'], input=data, capture_output=True, text=True)
            error = None if result.returncode == 0 else (helper_error(result.stderr) or _('Could not save'))

            def done():
                self._kbd_saving -= 1
                self._end(error, done_text)
                self._reload_kbd_later()   # on failure the controls revert to the file's values
                return False
            GLib.idle_add(done)
        threading.Thread(target=worker, daemon=True).start()

    def _save_kbd_later(self, *keys):
        # save when the threshold stops changing, not on every step
        self._kbd_later_keys.update(keys)
        if getattr(self, '_kbd_save_timer', 0):
            GLib.source_remove(self._kbd_save_timer)

        def fire():
            self._kbd_save_timer = 0
            keys, self._kbd_later_keys = self._kbd_later_keys, set()
            self._save_kbd(_('Saved'), *keys)
            return False
        self._kbd_save_timer = GLib.timeout_add(800, fire)

    def _reload_kbd_later(self):
        # the file is written by rename (several events): coalesce and read once
        if self._kbd_reload_timer:
            GLib.source_remove(self._kbd_reload_timer)
        self._kbd_reload_timer = GLib.timeout_add(300, self._reload_kbd)

    def _reload_kbd(self):
        self._kbd_reload_timer = 0
        # don't touch the controls while a change is pending or being written;
        # the file is re-read when the write finishes
        if self._kbd_saving or getattr(self, '_kbd_save_timer', 0):
            return False
        cfg = self._kbd_cfg = kbd_config()
        self._updating = True
        try:
            self.timeout_row.set_selected(next((i for i, (s, _) in enumerate(TIMEOUTS)
                                                if s == cfg.get('idle_timeout_s')), self.timeout_row.get_selected()))
            self.daytime_row.set_active(cfg.get('off_in_daytime', True))
            self.battery_only_row.set_active(cfg.get('battery_only', True))
            if hasattr(self, 'dark_row'):
                self.dark_row.set_active(cfg.get('dark_turn_on', False))
                self.threshold_row.set_value(cfg.get('dark_threshold', 20))
                self.very_dark_row.set_value(cfg.get('very_dark_threshold', 8))
                self.sensitivity_row.set_selected(cfg.get('screen_sensitivity', 2) - 1)
                self.osd_row.set_active(cfg.get('osd', True))
                self.sun_full_row.set_active(cfg.get('sun_full', True))
                self.sun_row.set_value(cfg.get('sun_threshold', 1000))
                self.method_row.set_selected(0 if cfg.get('screen_method', 'stages') == 'stages' else 1)
                for row, value in zip(self.stage_rows, cfg.get('screen_stages') or SCREEN_PERCENTS):
                    row.set_value(value)
                self.presence_row.set_active(cfg.get('presence', False))
                self.presence_delay_row.set_selected(next((i for i, (sec, _) in enumerate(PRESENCE_DELAYS)
                                                           if sec == cfg.get('presence_s', 60)), 1))
                self.presence_camera_row.set_selected(1 if cfg.get('presence_camera') == 'normal' else 0)
                self.screen_row.set_active(cfg.get('screen_auto', False))
                self.interval_row.set_selected(next((i for i, (sec, _) in enumerate(LIGHT_INTERVALS)
                                                     if sec == cfg.get('measure_interval_s')),
                                                    self.interval_row.get_selected()))
                if getattr(self, '_last_light', None) is not None:
                    self._mark_stage(self._last_light)   # thresholds may have changed
                else:
                    for i, row in enumerate(self.stage_rows):
                        row.set_subtitle(self._stage_hint(i))
        finally:
            self._updating = False
        self._sync_kbd_texts(force=True)
        return False

    def _sync_kbd_texts(self, force=False):
        """Keyboard descriptions based on power-saving settings (when Fn+F6 gets corrected, etc.)."""
        if not hasattr(self, 'battery_only_row'):
            return
        battery_only = self.battery_only_row.get_active()
        ambient = self._kbd_cfg.get('dark_turn_on', False)
        mains = _('what you choose is kept when plugged in') if battery_only else _('also when plugged in')
        self.kbd_light_group.set_description(
            _('You can also change it with Fn+F6; automatic on/off is on: it is corrected to the ambient light '
              'after a few seconds ({when}).').format(when=mains) if ambient else
            _('You can also change it with Fn+F6.'))
        self.ambient_kbd_group.set_description(
            _('The goal is saving power: even if you change it with Fn+F6, it is corrected to the ambient light '
              'after a few seconds (on battery only; can be changed on the Power Saving page).') if battery_only else
            _('The goal is saving power: even if you change it with Fn+F6, it is corrected to the ambient light '
              'after a few seconds.'))
        self.timeout_row.set_subtitle(
            _("The backlight turns off if the keyboard and touchpad aren't touched for this long (also when "
              'plugged in) and turns back on when touched'))
        # sunrise/sunset is computed once a day (or when the location changes)
        key = (time.strftime('%Y-%m-%d'), str(self._kbd_cfg.get('location')))
        if force or self._sun[0] != key:
            self._sun = (key, sun_times(self._kbd_cfg.get('location') or gnome_location()))
        times = self._sun[1]
        self.daytime_row.set_subtitle(
            (_('Between sunrise and sunset the backlight starts off at boot, at login and when waking from sleep '
               '(based on location; left alone when plugged in).') if battery_only else
             _('Between sunrise and sunset the backlight starts off at boot, at login and when waking from sleep '
               '(based on location).')) + ' ' +
            (_('It stays on if the room is dark; even if you turn it on with Fn+F6, it turns off again after a few '
               'seconds if the room is bright') if ambient else _('It can be turned on with Fn+F6')) + '\n' +
            (_('Daytime here today: {sunrise}–{sunset}').format(sunrise=times[0], sunset=times[1]) if times else
             _('Location unknown: turn on Settings → Privacy → Location Services')))

    def _measure_light(self, calibrate=False):
        """Measure with the camera (as the user, who has camera access)."""
        for row in self._light_rows():
            row.set_subtitle(_('Measuring…'))

        def worker():
            r = subprocess.run([LIGHT_TOOL], capture_output=True, text=True)
            value = None
            if r.returncode == 0:
                try:
                    value = float(r.stdout)
                except ValueError:
                    pass

            def done():
                for row in self._light_rows():
                    if value is None:
                        row.set_subtitle(helper_error(r.stderr) or _('Could not measure'))
                    else:
                        row.set_subtitle(self._light_text(value, time.strftime('%H:%M')))
                if value is None:
                    return False
                self._manual_light = (value, time.time())
                self._mark_stage(value)
                if calibrate == 'sun':
                    if value <= 300:
                        self.toast(_('Measurement {value}: too low for sunlight (normal room ~50-255)').format(
                            value=f'{value:.0f}'))
                        return False
                    self.sun_row.set_value(max(256, value * 0.7))
                    self.toast(_('Sunlight threshold {value}: in light this bright the screen is at full '
                                 'brightness').format(value=int(self.sun_row.get_value())))
                elif calibrate == 'very-dark':
                    self.very_dark_row.set_value(min(max(value * 1.5, value + 2), self.threshold_row.get_value()))
                    self.toast(_('Very dark threshold {value}: this dark, the keyboard backlight is bright').format(
                        value=int(self.very_dark_row.get_value())))
                elif calibrate:
                    self.threshold_row.set_value(max(value * 1.5, value + 3))
                    self.toast(_('Threshold {value}: a room this dark or darker counts as dark').format(
                        value=int(self.threshold_row.get_value())))
                return False
            GLib.idle_add(done)
        threading.Thread(target=worker, daemon=True).start()

    def _on_timeout(self, row, _p):
        if self._updating:
            return
        seconds, label = TIMEOUTS[row.get_selected()]
        self._save_kbd(_('Turning off when idle disabled') if not seconds else
                       _('The keyboard backlight will turn off after {time}').format(time=label),
                       'idle_timeout_s')

    def _on_daytime(self, row, _p):
        if not self._updating:
            self._save_kbd(_('Starting off during daytime turned on') if row.get_active() else
                           _('Starting off during daytime turned off'), 'off_in_daytime')

    def _sync_location(self):
        """Tell the service if the location changed (travel); once at startup."""
        where = gnome_location()
        saved = kbd_config().get('location')
        if (where and KBD_CONFIG.exists()
                and (not saved or tuple(round(x, 4) for x in saved) != where)):
            self._write_kbd({'location': list(where)}, _('Location updated'))

    def _run_root_async(self, argv, done_text):
        self._run_steps_async([argv], done_text)

    def _begin(self):
        self._pending += 1
        self._generation += 1

    def _end(self, error, done_text):
        self._pending -= 1
        self._generation += 1
        self.toast(error or done_text)
        self.refresh(full=True)
        return GLib.SOURCE_REMOVE

    def _on_fan_mode(self, name):
        if not self._updating and name:
            self._run_root_async([HELPER, 'fan', name],
                                 _('Fan Boost turned on') if name == 'max' else _('Fan in automatic mode'))

    def _perf_write(self, mode, level):
        name, label, watts = PERF_LEVELS[mode][level]
        self._run_root_async([HELPER, 'performance', f'{mode}-{name}'],
                             f'{dict(PERF_MODES)[mode]} · {label} ({watts.split(",")[0]})')

    def _on_perf_mode(self, mode):
        if not self._updating and mode:
            self._perf_write(mode, self.perf[1] if self.perf else 1)

    def _on_perf_level(self, level):
        if not self._updating and level is not None:
            self._perf_write(self.perf[0] if self.perf else 'balanced', int(level))

    def _on_boost(self, row, _p):
        if not self._updating:
            on = row.get_active()
            self._run_root_async([HELPER, 'fan', 'max' if on else 'auto'],
                                 _('Fan Boost turned on') if on else _('Fan in automatic mode'))

    def _on_touchpad_toggle(self, row, _p):
        if not self._updating:
            on = row.get_active()
            self._run_root_async([HELPER, 'touchpad-toggle', 'on' if on else 'off'],
                                 _('Touchpad shortcut turned on') if on else _('Touchpad shortcut turned off'))

    def _run_steps_async(self, steps, done_text):
        """Runs commands in order in the background, stopping at the first error."""
        self._begin()

        def worker():
            error = None
            for argv in steps:
                error = run_root(*argv)
                if error:
                    break
            GLib.idle_add(self._end, error, done_text)
        threading.Thread(target=worker, daemon=True).start()

    def _on_ac_recover(self, row, _p):
        if self._updating:
            return
        on = row.get_active()
        steps = [[UEFI_HELPER, 'ac-recover', 'on' if on else 'off']]
        if on and self.usb_row.get_active():
            steps.insert(0, [HELPER, 'usb-power', 'off'])
        self._run_steps_async(steps, _('Power on when plugged in turned on; takes effect after a restart') if on else
                              _('Power on when plugged in turned off; takes effect after a restart'))

    def _on_usb_power(self, row, _p):
        if self._updating:
            return
        on = row.get_active()
        steps = [[HELPER, 'usb-power', 'on' if on else 'off']]
        if on and self.ac_row.get_active():
            steps.insert(0, [UEFI_HELPER, 'ac-recover', 'off'])
        self._run_steps_async(steps, _('USB power while off turned on') if on else _('USB power while off turned off'))

    def _on_super_lock(self, row, _p):
        if not self._updating:
            on = row.get_active()
            self._run_root_async([HELPER, 'super-key-lock', 'on' if on else 'off'],
                                 _('Windows key locked') if on else _('Windows key unlocked'))

    def _on_fn_lock(self, row, _p):
        if not self._updating:
            on = row.get_active()
            self._run_root_async([HELPER, 'fn-lock', 'on' if on else 'off'],
                                 _('Fn lock turned on') if on else _('Fn lock turned off'))

    def _on_charge_choice(self, row, _p, command, options):
        if not self._updating:
            name, label = options[row.get_selected()][:2]
            self._run_root_async([HELPER, command, name], f'{row.get_title()}: {label}')

    def _on_profile(self, name):
        # when the power mode changes, tuned writes to the driver and controller; this can
        # take a few seconds, so don't block the UI
        if not self._updating and name and self.up.profiles:
            self._begin()
            self.up.profiles.call(
                'org.freedesktop.DBus.Properties.Set',
                GLib.Variant('(ssv)', ('org.freedesktop.UPower.PowerProfiles', 'ActiveProfile',
                                       GLib.Variant('s', name))),
                0, -1, None, lambda proxy, res: self._dbus_done(
                    proxy, res, _('Power mode: {mode}').format(mode={
                        'power-saver': _('Power Saver'), 'balanced': _('Balanced'),
                        'performance': _('Performance')}.get(name, name))))

    def _on_card_mode(self, row, _p):
        mode, label, sub = CARD_MODES[row.get_selected()]
        row.set_subtitle(sub)
        if self._updating:
            return
        steps = {'off': [('card-reader-off', 'on')],
                 'sleep': [('card-reader-off', 'off'), ('card-reader-sleep', 'on')],
                 'on': [('card-reader-off', 'off'), ('card-reader-sleep', 'off')]}[mode]
        self._run_steps_async([[POWER_HELPER, *step] for step in steps],
                              _('SD card reader: {mode}').format(mode=label.lower()))

    def _on_power_setting(self, row, _p, feature):
        if not self._updating:
            self._run_root_async([POWER_HELPER, feature, 'on' if row.get_active() else 'off'], _('Setting applied'))


# Other names for --page
PAGE_ALIASES = {'general': 'overview', 'auto': 'automation', 'ambient-light': 'ambient',
                'power-saving': 'power', 'info': 'about'}


class App(Adw.Application):
    def __init__(self):
        # the command line is forwarded to the first instance: "--page battery" switches pages while running
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self._page = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        theme.add_search_path(str(HERE / 'icons'))  # when running from the repo
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        self._page = START_PAGE
        if '--page' in args:
            i = args.index('--page')
            self._page = args[i + 1] if i + 1 < len(args) else None
        self._page = PAGE_ALIASES.get(self._page, self._page)
        self.activate()
        return 0

    def do_activate(self):
        window = self.get_active_window() or Window(self)
        page = self._page or START_PAGE
        if page:
            window.show_page(page)
        window.present()


if __name__ == '__main__':
    # huma-control --page overview|performance|automation|fan|keyboard|ambient|battery|power|history|about
    START_PAGE = None   # tests set this directly; the command line is handled in do_command_line
    sys.exit(App().run(sys.argv))
