def alert_text(alert):
    """Title and text of a service alert."""
    known = ALERT_TEXTS.get(alert.get('code'))
    data = alert.get('data')
    if known and isinstance(data, dict):
        values = dict(data)
        for key in ('full_wh', 'design_wh'):
            if isinstance(values.get(key), (int, float)):
                values[key] = dec(values[key])
        if 'percent' in values:
            values['percent'] = pct(values['percent'])
        try:
            return known[0], known[1].format(**values)
        except (KeyError, IndexError, ValueError):
            pass
    return alert.get('title', ''), alert.get('text', '')


