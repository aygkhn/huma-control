# ---------------------------------------------------------------- hardware reading

def read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def hwmon(name):
    base = Path('/sys/class/hwmon')
    for h in sorted(base.iterdir()) if base.exists() else []:
        if read(h / 'name') == name:
            return h
    return None


def cpu_temp():
    h = hwmon('coretemp') or hwmon('k10temp')
    value = read(h / 'temp1_input') if h else None
    return int(value) / 1000 if value else None


def fan_state(boost=None):
    fan, pwm = hwmon('qc71_laptop.hwmon.fan'), hwmon('qc71_laptop.hwmon.pwm')
    if not fan or not pwm:
        return None
    if boost is None:   # cache not filled yet: read from the driver (pwm1_enable also changes with a custom curve)
        boost = read(QC71 / 'fan_boost')
    boost = boost == '1'
    rpm, temp = int(read(fan / 'fan1_input', '0')), int(read(fan / 'temp1_input', '0')) / 1000
    # the controller occasionally returns garbage: keep the previous value
    last = fan_state.last
    rpm = last.get('rpm') if rpm > 7000 else rpm
    temp = last.get('temp') if temp > 110 else temp
    fan_state.last = {'rpm': rpm, 'temp': temp}
    return {
        'rpm': rpm,
        'temp': temp,
        # Fan Boost: the controller runs the fan at full speed (0x0751 bit 6)
        'mode': 'max' if boost else 'auto',
    }


fan_state.last = {}


def ac_recover():
    """The power-on-AC setting in UEFI: True/False, or None if unsupported."""
    try:
        data = UNIWILL_VAR.read_bytes()[4:]
    except OSError:
        return None
    if len(data) != 180 or data[6] != 0x13 or data[94] != 1:
        return None
    return data[95] == 1


def battery_info():
    if not BATTERY.exists():
        return None
    num = lambda name: int(read(BATTERY / name, '0') or 0)
    volts = num('voltage_min_design') / 1e6
    full, design = num('charge_full') / 1e6 * volts, num('charge_full_design') / 1e6 * volts
    if not design:
        full, design = num('energy_full') / 1e6, num('energy_full_design') / 1e6
    return {'full': full, 'design': design, 'cycles': num('cycle_count'),
            'tech': read(BATTERY / 'technology', ''), 'status': read(BATTERY / 'status', '')}


def device_info():
    dmi = lambda name: read(f'/sys/class/dmi/id/{name}', '') or '—'
    cpu = next((l.split(':', 1)[1].strip() for l in (read('/proc/cpuinfo', '') or '').splitlines()
                if l.startswith('model name')), '—')
    mem = next((int(l.split()[1]) for l in (read('/proc/meminfo', '') or '').splitlines()
                if l.startswith('MemTotal')), 0)
    project = read(QC71 / 'project_id')
    return [
        (_('Model'), f'{dmi("sys_vendor").title()} {dmi("product_name")}'),
        (_('Motherboard'), dmi('board_name')),
        ('BIOS', f'{dmi("bios_version")} ({dmi("bios_date")})'),
