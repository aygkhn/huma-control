KBD_CONFIG = Path('/etc/huma-control/keyboard.json')

def gnome_location():
    """The last location GNOME stored for Night Light."""
    try:
        lat, lon = Gio.Settings.new('org.gnome.settings-daemon.plugins.color').get_value(
            'night-light-last-coordinates').unpack()
    except Exception:
        return None
    # GNOME stores (91, 181) if no location was ever obtained
    if not (-90 <= lat <= 90 and -180 <= lon <= 180) or not (lat or lon):
        return None
    return round(lat, 4), round(lon, 4)


def kbd_config():
    """Settings of the keyboard backlight service (huma-control-keyboard)."""
    config = {'idle_timeout_s': 15, 'off_in_daytime': True, 'location': None}
    data = read_json(KBD_CONFIG)
    if isinstance(data, dict):
        config |= data
    return config


def sun_times(where=None):
    """Today's sunrise and sunset for the location (local time), same calculation as the keyboard service."""
    from datetime import timedelta, timezone
    where = where or kbd_config().get('location') or gnome_location()
    if not where:
        return None
    lat, lon = where
    now = datetime.now(timezone.utc)
    g = 2 * math.pi / 365 * (now.timetuple().tm_yday - 1)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g) -
                       0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g) +
            0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    cos_ha = (math.cos(math.radians(90.833)) / (math.cos(math.radians(lat)) * math.cos(decl)) -
              math.tan(math.radians(lat)) * math.tan(decl))
    if abs(cos_ha) >= 1:
        return None
    ha = math.degrees(math.acos(cos_ha))
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)
    local = lambda minutes: (midnight + timedelta(minutes=minutes)).astimezone().strftime('%H:%M')
    return local(720 - 4 * (lon + ha) - eqtime), local(720 - 4 * (lon - ha) - eqtime)


def run_root(*argv):
    """Runs a helper via pkexec; returns the error text on failure."""
    result = subprocess.run(['pkexec', *argv], capture_output=True, text=True)
    if result.returncode in (126, 127) and not result.stderr.strip():
        return _('Not authorized')
    return None if result.returncode == 0 else (helper_error(result.stderr) or _('Operation failed'))


class Upower:
    """UPower D-Bus interfaces for the battery, keyboard backlight and power profile.
    If UPower or power-profiles is missing, the related parts return nothing."""

    def __init__(self):
        def proxy(name, path, iface):
            try:
                return Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, name, path, iface)
            except GLib.Error:
                return None
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        except GLib.Error:
            bus = None
        self.display = bus and proxy('org.freedesktop.UPower', '/org/freedesktop/UPower/devices/DisplayDevice',
                                     'org.freedesktop.UPower.Device')
        self.kbd = bus and proxy('org.freedesktop.UPower', '/org/freedesktop/UPower/KbdBacklight',
                                 'org.freedesktop.UPower.KbdBacklight')
        self.profiles = bus and proxy('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles',
                                      'org.freedesktop.UPower.PowerProfiles')
        try:
            self.kbd_max = self.kbd.call_sync('GetMaxBrightness', None, 0, -1, None).unpack()[0] if self.kbd else 0
        except GLib.Error:
            self.kbd_max = 0

    def battery(self):
        if not self.display or self.display.get_name_owner() is None:
            return None
        p = lambda name: (v.unpack() if (v := self.display.get_cached_property(name)) else None)
        return {'percent': p('Percentage') or 0, 'state': p('State') or 0, 'rate': p('EnergyRate') or 0,
                'to_empty': p('TimeToEmpty') or 0, 'to_full': p('TimeToFull') or 0}

    def kbd_brightness(self):
        if not self.kbd_max:
            return None
        try:
            return self.kbd.call_sync('GetBrightness', None, 0, -1, None).unpack()[0]
        except GLib.Error:
            return None

    def profile(self):
        v = self.profiles.get_cached_property('ActiveProfile') if self.profiles else None
        return v.unpack() if v else None


def fmt_time(seconds):
    minutes = round(seconds / 60)
    if minutes >= 60:
        return _('{hours} h {minutes} min').format(hours=minutes // 60, minutes=minutes % 60)
    return _('{minutes} min').format(minutes=minutes)


