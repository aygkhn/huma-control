    def _add_app_rule(self, name, match, profile, app_id=None, battery_only=False):
        if any((app_id and r.get('app_id') == app_id) or (match and r['match'] == match) for r in self.auto_rules):
            self.toast(_('There is already a rule for {name}').format(name=name))
            return
        rule = {'name': name, 'match': match, 'profile': profile, 'battery_only': battery_only}
        if app_id:
            rule['app_id'] = app_id
        self.auto_rules.append(rule)
        self._render_rules()
        self.toast(_('{name} added; press Save to apply').format(name=name))

