    def _save_auto(self):
        pnames = [n for n, _ in PROFILE_NAMES]
        pick = lambda row: '' if row.get_selected() == 0 else pnames[row.get_selected() - 1]
        config = {
            'enabled': self.auto_enabled.get_active(),
            'on_ac': pick(self.auto_ac),
            'on_battery': pick(self.auto_bat),
            'night': {'enabled': self.night_on.get_active(), 'start': self.night_start.get_text().strip(),
                      'end': self.night_end.get_text().strip(), 'profile': pnames[self.night_profile.get_selected()]},
            'apps': self.auto_rules,
        }
        data = json.dumps(config, ensure_ascii=False)

        def worker():
            result = subprocess.run(['pkexec', HELPER, 'automation'], input=data, capture_output=True, text=True)
            error = None if result.returncode == 0 else (helper_error(result.stderr) or _('Could not save'))

            def done():
                if not error:
                    self.auto_config = config   # the "Now" row follows the saved config
                self.toast(error or _('Automatic profiles saved'))
                return False
            GLib.idle_add(done)
        threading.Thread(target=worker, daemon=True).start()

    def _apply_light(self, data):
        light = data.get('light')
        if not (light and isinstance(light.get('value'), (int, float))):
            return
        value = light['value']
        stamp = light.get('time', '')
        try:
            when = datetime.fromisoformat(stamp).timestamp()
        except (TypeError, ValueError):
            when = 0
        # don't let an older service measurement overwrite the "Measure Now" result
        if not (self._manual_light and when <= self._manual_light[1]):
            for row in self._light_rows():
                if not (row.get_subtitle() or '').startswith(_('Measuring…')):
                    row.set_subtitle(self._light_text(value, stamp[11:16]))
            self._mark_stage(value)
        self._show_decision()

    def _show_decision(self):
        d = read_json(BRIGHTNESS_STATE)
        if not isinstance(d, dict):
            self.decision_row.set_subtitle(_('No decision yet (made at the first measurement after login)'))
            return
        stage = SCREEN_STAGES[d['stage']] if isinstance(d.get('stage'), int) else '?'
        # the result code written by the extension is shown translated
        results = {'manual-kept': _('manual setting kept'), 'applied': _('applied'),
                   'small-difference': _('difference too small')}
        text = _('{time} · measurement {value} → {stage}, screen target {target} · {result}').format(
            time=d.get('time', ''), value=d.get('median'), stage=stage, target=pct(d.get('target')),
            result=results.get(d.get('result'), d.get('result')))
        if d.get('result') == 'manual-kept':
            text += ' ' + _('(brightness changed manually at {time}; ends when the ambient light moves to another '
                            'level)').format(time=d.get('last_manual') or '?')
        self.decision_row.set_subtitle(text)

    def _sync_method(self):
        """Levels method shows the percentages; relative method shows sensitivity and full brightness in sunlight."""
        stages = self.method_row.get_selected() == 0
        self.stages_group.set_visible(stages)
        self.sensitivity_row.set_visible(not stages)
        self.sun_full_row.set_visible(not stages)

    def _anchors(self):
        return stage_anchors(self.threshold_row.get_value(), self.very_dark_row.get_value(), self.sun_row.get_value())

    def _mark_stage(self, value):
        """Mark the current ambient level in the screen percentage list."""
        self._last_light = value
        current = nearest_stage(value, self._anchors())
        for i, row in enumerate(self.stage_rows):
            row.set_subtitle(self._stage_hint(i) + ('  ·  ' + _('NOW') if i == current else ''))
        self._remember_hint(current)

    def _remember_hint(self, stage=None):
        """Subtitle of the 'Save' row: which percentage will be stored for which level."""
        if not hasattr(self, 'remember_row'):
            return
        percent = screen_percent()
        now = (_('Current ambient light: {stage}, screen {percent}.').format(stage=SCREEN_STAGES[stage],
                                                                             percent=pct(percent))
               if stage is not None and percent is not None
               else _('First measure the ambient light with "Measure Now".'))
        self.remember_row.set_subtitle(
            now + ' ' + _('Instead of typing a percentage, set the screen to what suits your eyes with the '
                          'brightness slider (or the brightness keys), then press Save: the current screen percentage '
                          'is stored for this ambient level, and from then on the screen always goes to this '
                          'brightness in this light.'))

    def _stage_hint(self, i):
        a = self._anchors()
        return [_('Measurement ~{value} and below'), _('Measurement ~{value}'),
                _('Measurement ~{value} (normal room)'), _('Measurement ~{value} (by a window)'),
                _('Measurement ~{value} and above (sunlight threshold)')][i].format(value=f'{a[i]:.0f}')

    def _test_presence(self):
        """Test face detection (as the user, who has camera access)."""
        camera = 'normal' if self.presence_camera_row.get_selected() == 1 else 'auto'
        self.toast(_('Checking…'))

        def worker():
            r = subprocess.run([FACE_TOOL, camera], capture_output=True, text=True)
            text = (_('The camera is in use by another app: someone is assumed to be there') if r.returncode == 2 else
                    _("Someone is there: the screen won't dim") if r.stdout.strip() == '1' else
                    _('Nobody is there: the screen would lock and turn off') if r.stdout.strip() == '0' else
                    helper_error(r.stderr) or _('Could not check'))
            GLib.idle_add(lambda: self.toast(text) and False)
        threading.Thread(target=worker, daemon=True).start()

    def _stage_changed(self, index):
        """Keep levels increasing from dark to bright: move neighboring levels along if needed."""
        value = self.stage_rows[index].get_value()
        self._updating = True
        for i, row in enumerate(self.stage_rows):
            if i < index and row.get_value() > value or i > index and row.get_value() < value:
                row.set_value(value)
        self._updating = False
        self._save_kbd_later('screen_stages')

    def _remember_stage(self):
        """Store the current screen brightness for the current ambient level."""
        value = getattr(self, '_last_light', None)
        percent = screen_percent()
        if value is None or percent is None:
            self.toast(_('Measure first') if value is None else _('Could not read the screen brightness'))
            return
        stage = nearest_stage(value, self._anchors())
        self.stage_rows[stage].set_value(max(5, min(100, round(percent / 5) * 5)))
        self.toast(_('Saved: in "{stage}" light the screen is now at {percent}').format(
            stage=SCREEN_STAGES[stage], percent=pct(int(self.stage_rows[stage].get_value()))))

    def _light_text(self, value, stamp):
        """Measurement and screen level (same calculation as "NOW" in the level list)."""
        return f'{value:.0f} · {SCREEN_STAGES[nearest_stage(value, self._anchors())]} ({stamp})'

    def _apply_auto(self, data):
        state = data.get('auto_state')
        if not hasattr(self, 'auto_status'):
            return
        labels = dict(PROFILE_NAMES)
        if state and state.get('profile'):
            self.auto_status.set_subtitle(f"{auto_reason(state)} → {labels.get(state['profile'], state['profile'])}")
        else:
            self.auto_status.set_subtitle(_('No rule applies') if self.auto_config.get('enabled') else _('Off'))

