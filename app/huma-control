    def _on_kbd_signal(self, _proxy, _sender, signal, params):
        # reflect changes made with Fn+F6 immediately
        if signal.startswith('BrightnessChanged'):
            self._updating = True
            self.kbd_toggle.set_active_name(str(min(params.unpack()[0], 2)))
            self._updating = False

    def _on_kbd_level(self, name):
        if not self._updating and name is not None and self.up.kbd:
            self._begin()
            self.up.kbd.call('SetBrightness', GLib.Variant('(i)', (int(name),)), 0, -1, None,
                             lambda proxy, res: self._dbus_done(proxy, res, _('Keyboard backlight: {level}').format(
                                 level=KBD_LEVELS[int(name)])))

    def _dbus_done(self, proxy, res, done_text):
        try:
            proxy.call_finish(res)
            error = None
        except GLib.Error as e:
            error = e.message
        self._end(error, done_text)

