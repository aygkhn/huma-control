    def _load_history(self):
        if not hasattr(self, 'history_range'):
            return
        days = int(self.history_range.get_active_name() or 1)
        keys = list(self.charts)
        # if the range changes quickly, don't let an earlier (slow) read overwrite a newer one
        self._history_gen = generation = getattr(self, '_history_gen', 0) + 1

        def worker():
            import csv
            from datetime import datetime as dt
            since = time.time() - days * 86400
            rows = []
            try:
                with HISTORY_FILE.open() as f:
                    for r in csv.DictReader(f):
                        try:
                            t = dt.fromisoformat(r['time']).timestamp()
                        except (KeyError, TypeError, ValueError):
                            continue
                        if t >= since:
                            rows.append((t, r))
            except OSError:
                pass
            alerts = read_json(ALERTS_FILE)
            alerts = alerts.get('alerts', []) if isinstance(alerts, dict) else []
            # ~130k rows for 90 days: summarize here too so the UI doesn't freeze
            summary = self._summarize_history(rows, since, keys)
            GLib.idle_add(lambda: generation == self._history_gen and self._show_history(summary, alerts) and False)
        threading.Thread(target=worker, daemon=True).start()

    @staticmethod
    def _summarize_history(rows, since, keys):
        """Chart points and summary rows (runs in the background)."""
        def num(v):
            try:
                return float(v) if v not in ('', None) else None
            except ValueError:
                return None
        # at most ~600 points: average over buckets
        span = (since, time.time())
        bucket = max(60, (span[1] - span[0]) / 600)
        charts = {}
        for key in keys:
            buckets = {}
            for t, r in rows:
                v = num(r.get(key))
                if key == 'watts':
                    v = -v if v is not None and v < 0 else None   # only power drawn from the battery
                if v is not None:
                    buckets.setdefault(int(t // bucket), []).append(v)
            times = sorted(buckets)
            charts[key] = ([k * bucket for k in times], [sum(buckets[k]) / len(buckets[k]) for k in times], span)
        draw = [-w for _, r in rows if (w := num(r.get('watts'))) is not None and w < 0]
        temps = [v for _, r in rows if (v := num(r.get('cpu_c'))) is not None]
        caps = [v for _, r in rows if (v := num(r.get('full_wh'))) is not None]
        profiles = {}
        for _t, r in rows:
            if r.get('profile'):   # rows without a readable profile are skipped
                profiles[r['profile']] = profiles.get(r['profile'], 0) + 1
        labels = dict(PROFILE_NAMES)
        total = sum(profiles.values()) or 1
        # entries rounding to 0% are omitted
        profiles = {k: v for k, v in profiles.items() if round(100 * v / total) > 0}
        return charts, {
            'avg': f'{dec(sum(draw) / len(draw))} W' if draw else _('No records'),
            'max': f'{max(temps):.0f} °C' if temps else _('No records'),
            'cap': f'{dec(caps[0])} → {dec(caps[-1])} Wh' if caps else _('No records'),
            'profile': ', '.join(f"{labels.get(k, k)} {pct(f'{100 * v / total:.0f}')}"
                                for k, v in sorted(profiles.items(), key=lambda x: -x[1])[:3]) or _('No records'),
        }

    def _show_history(self, summary, alerts):
        charts, texts = summary
        for key, data in charts.items():
            self.charts[key].set_data(*data)
        for key, text in texts.items():
            self.hist_rows[key].set_subtitle(text)
        for row in self.alert_rows:
            self.alerts_group.remove(row)
        self.alert_rows = []
        for a in reversed(alerts[-5:]):
            title, text = alert_text(a)
            row = Adw.ActionRow(title=title, subtitle=f"{a.get('time', '').replace('T', ' ')} · {text}")
            decorate((row, 'dialog-warning-symbolic', 'red'))
            self.alerts_group.add(row)
            self.alert_rows.append(row)
        if not alerts:
            row = Adw.ActionRow(title=_('No alerts'), subtitle=_('Watching for overheating, fan failure and battery '
                                                                 'health'))
            decorate((row, 'emblem-ok-symbolic', 'green'))
            self.alerts_group.add(row)
            self.alert_rows.append(row)

    # ---- diagnostic report

    def _diagnostics(self):
        def worker():
            def run(*cmd):
                try:
                    r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
                    return (r.stdout + r.stderr).strip()
                except Exception as e:
                    return f'({e})'
            parts = [(_('System'), run('uname', '-a')), (_('Driver'), run('modinfo', '-F', 'version', 'qc71_laptop')),
                     ('DKMS', run('dkms', 'status')),
                     (_('Modules'), run('sh', '-c', 'lsmod | grep -E "qc71|uniwill|led_class"')),
                     (_('Services'), run('systemctl', 'is-active', 'huma-control-service', 'huma-control-keyboard',
                                         'tuned', 'tuned-ppd')),
                     (_('Power mode'), run('tuned-adm', 'active')),
                     (_('Module options'), run('sh', '-c', 'grep -H . /etc/modprobe.d/qc71*')),
                     (_('Huma Control Center settings'), run('sh', '-c', 'grep -H . /etc/huma-control/* 2>&1')),
                     (_('Driver files'), run('sh', '-c', f'cd {QC71} && grep -H . * 2>/dev/null')),
                     (_('Wireless'), run('rfkill', 'list')),
                     (_('Extensions'), run('gnome-extensions', 'list', '--enabled')),
                     (_('Driver log'), run('journalctl', '-b', '-k', '--no-pager', '-g', 'qc71', '-n', '80')),
                     (_('Service log'), run('journalctl', '-b', '--no-pager', '-n', '60', '-u', 'huma-control-service',
                                            '-u', 'huma-control-keyboard'))]
            folder = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or GLib.get_home_dir())
            path = folder / f'huma-control-diagnostics-{time.strftime("%Y%m%d-%H%M")}.txt'
            text = _('Huma Control Center diagnostic report — {time}').format(time=time.strftime('%Y-%m-%d %H:%M')) + \
                '\n\n' + '\n\n'.join(f'== {title} ==\n{body}' for title, body in parts) + '\n'
            try:
                path.write_text(text)
                message = _('Diagnostic report: {path}').format(path=path)
                Gio.AppInfo.launch_default_for_uri(folder.as_uri(), None)
            except OSError as e:
                message = _('Could not write the diagnostic report: {error}').format(error=e)
            GLib.idle_add(lambda: self.toast(message) and False)
        self.toast(_('Preparing diagnostic report…'))
        threading.Thread(target=worker, daemon=True).start()

    # ---- periodic refresh

    def refresh(self, full=False):
        """Reads the hardware in the background. Controller (EC) reads over WMI are slow
        (~30-80 ms), so fast-changing values are read every 2 s and settings every 10 s
        or right after a change."""
        # every controller read means dozens of interrupts (~100/s with the window focused):
        # every 2 s when focused; every 10 s in the background, and only values that don't touch
        # the controller (temperature, battery, power mode); never when minimized or hidden.
        # Driver-side changes (mode key, Fan Boost) arrive via udev, and focusing triggers a full read.
        if not full and self.is_suspended():
            return GLib.SOURCE_CONTINUE
        light = not full and not self.is_active()
        if light and self._tick % 5:
            self._tick += 1
            return GLib.SOURCE_CONTINUE
        full = full or (not light and self._tick % 5 == 0)
        self._tick += 1
        if self._reading:
            # a read is in progress: do a full read when it finishes
            self._want_full |= full
        else:
            self._reading = True
            threading.Thread(target=self._gather, args=(full, self._generation, light), daemon=True).start()
        return GLib.SOURCE_CONTINUE

    def _gather(self, full, generation, light=False):
        data = {}
        try:
            data = {
                'temp': cpu_temp(),
                # in the background the fan isn't read from the controller: show the last value
                'fan': self._last_fan if light and self._last_fan else fan_state(self._cache.get('fan_boost')),
                'fan_duty': self._last_duty if light else read(QC71 / 'fan_duty'),
                'bat': self.up.battery(),
                'profile': self.up.profile(),
                'auto_state': read_json(AUTO_STATE),
                'light': read_json(LIGHT_STATE),
            }
            self._last_fan, self._last_duty = data['fan'], data['fan_duty']
            if full:
                data |= {
                    'kbd': self.up.kbd_brightness(),
                    'ppd': read('/etc/tuned/ppd.conf', ''),
                    'card_reader': CARD_READER_RULE.exists(),
                    'card_off': CARD_READER_OFF.exists(),
                    'ac_recover': ac_recover(),
                    'battery': battery_info(),
                }
                for attr in ('fn_lock', 'super_key_lock', 'charging_priority', 'charging_profile',
                             'performance_profile', 'fan_boost', 'touchpad_toggle_enable', 'usb_powershare',
                             'fan_curve'):
                    data[attr] = read(QC71 / attr)
        except Exception as e:  # a read error must not stop the UI
            print(_('read error:'), e, file=sys.stderr)
        GLib.idle_add(self._apply, data, full, generation)

    def _apply(self, data, full, generation):
        self._reading = False
        if self._want_full:
            self._want_full = False
            GLib.idle_add(lambda: self.refresh(full=True) and False)
        # don't touch the controls if a change is in progress or finished during the read
        controls = self._pending == 0 and generation == self._generation
        if full and controls:
            self._cache |= data
        self._updating = True
        try:
            parts = [self._apply_overview]
            if controls:
                parts += [self._apply_fan_mode, self._apply_perf, self._apply_keys, self._apply_power,
                          self._apply_auto, self._apply_light, self._apply_fan_curve]
            for part in parts:
                try:
                    part(self._cache | data if controls else data)
                except Exception as e:
                    print(f'{part.__name__}:', e, file=sys.stderr)
        finally:
            self._updating = False
        return GLib.SOURCE_REMOVE

    def _apply_overview(self, data):
        temp, fan, bat = data.get('temp'), data.get('fan'), data.get('bat')
        self.temps.append(temp)
        self.rpms.append(fan['rpm'] if fan else None)
        self.graph.queue_draw()

        self.card_cpu.set(f'{temp:.0f}' if temp else '—', '°C',
                          _('Cool') if temp and temp < 55 else _('Warm') if temp and temp < 75 else _('Hot') if temp else '',
                          None if not temp else 'good' if temp < 55 else 'warn' if temp < 75 else 'bad')
        if fan:
            rpm, fan_temp = fan['rpm'], fan['temp']
            fan_temp = '—' if fan_temp is None else f'{fan_temp:.0f} °C'
            self.card_fan.set('—' if rpm is None else _('Stopped') if rpm == 0 else f'{rpm:,}'.replace(',', THOUSANDS_SEP),
                              '' if not rpm else _('rpm'),
                              _('{mode} · sensor {temperature}').format(
                                  mode=_('Fan Boost') if fan['mode'] == 'max' else _('Automatic'),
                                  temperature=fan_temp))
            self.row_rpm.set_subtitle('—' if rpm is None else _('Stopped') if rpm == 0 else
                                      _('{rpm} rpm').format(rpm=rpm))
            self.row_fan_temp.set_subtitle(fan_temp)
            duty = data.get('fan_duty')
            self.row_duty.set_visible(duty is not None)
            self.row_duty.set_subtitle(pct(duty) if duty is not None else '')
            self.chip_fan.set_label(_('Fan Boost') if fan['mode'] == 'max' else _('Fan: automatic'))
        else:
            self.card_fan.set('—', '', _('Driver not loaded'))
            self.chip_fan.set_label(_('Fan: unknown'))
        self.fan_toggle.get_parent().set_sensitive(bool(fan))
        self.fan_missing.set_visible(not fan)
        self.row_cpu_temp.set_subtitle(f'{temp:.0f} °C' if temp else '—')

        if not bat:
            self.card_power.set('—', '', _('UPower not available'))
            self.card_battery.set('—', '', '')
            return
        # UPower states: 1 charging, 2 discharging, 4 full, 5 pending charge
        state, rate = bat['state'], bat['rate']
        if state == 2:
            self.card_power.set(dec(rate), 'W',
                                _('Low') if rate < 8 else _('Medium') if rate < 15 else _('High'))
            self.card_battery.set(f'{bat["percent"]:.0f}', '%',
                                  _('{time} left').format(time=fmt_time(bat['to_empty'])) if bat['to_empty']
                                  else _('Discharging'))
        else:
            self.card_power.set(_('Plugged in'), '',
                                _('Charging +{power} W').format(power=dec(rate)) if state == 1 and rate else '')
            self.card_battery.set(f'{bat["percent"]:.0f}', '%',
                                  _('Full') if state == 4 else _('Pending charge') if state == 5 else
                                  _('{time} until full').format(time=fmt_time(bat['to_full']))
                                  if state == 1 and bat['to_full'] else
                                  _('Charging') if state == 1 else '')

    def _apply_fan_mode(self, data):
        # only while controls are updated, so it isn't reverted while a command runs
        fan = data.get('fan')
        if fan:
            self.fan_toggle.set_active_name(fan['mode'])

    def _apply_perf(self, data):
        value = data.get('performance_profile')
        self.perf_group.set_visible(value is not None)
        self.perf_missing.set_visible(value is None)
        if value is None:
            return
        mode, _sep, level = value.partition('-')
        names = [n for n, _, _ in PERF_LEVELS.get(mode, [])]
        self.perf = (mode, names.index(level)) if level in names else None
        levels = PERF_LEVELS[self.perf[0] if self.perf else 'balanced']
        for i, (_n, label, _w) in enumerate(levels):
            self.perf_level_toggle.get_toggle_by_name(str(i)).set_label(label)
        if self.perf:
            self.perf_mode_toggle.set_active_name(mode)
            self.perf_level_toggle.set_active_name(str(self.perf[1]))
            self.perf_level_row.set_subtitle(_('CPU power limit {limit}').format(limit=levels[self.perf[1]][2]))
        else:
            # a setting left over from Windows or unknown
            self.perf_mode_toggle.set_active(Gtk.INVALID_LIST_POSITION)
            self.perf_level_toggle.set_active(Gtk.INVALID_LIST_POSITION)
            self.perf_level_row.set_subtitle(_("The controller's setting wasn't recognized; choose a mode"))
        boost = data.get('fan_boost')
        self.boost_row.set_visible(boost is not None)
        self.boost_row.set_active(boost == '1')
        names = dict(PERF_MODES)
        self.chip_profile.set_label(f'{names[self.perf[0]]} · {levels[self.perf[1]][1]}' if self.perf else _('Custom mode'))
        for css in ('balanced', 'quiet', 'high', 'unknown'):
            self.mode_banner.remove_css_class(css)
        if self.perf:
            kind = 'quiet' if self.perf[0] == 'quiet' else 'high' if self.perf[1] == 2 else 'balanced'
            self.mode_banner.add_css_class(kind)
            self.mode_icon.set_from_icon_name({'quiet': 'power-profile-power-saver-symbolic',
                                               'high': 'power-profile-performance-symbolic'}.get(
                                                   kind, 'power-profile-balanced-symbolic'))
            self.mode_title.set_label(f'{names[self.perf[0]]} · {levels[self.perf[1]][1]}')
            self.mode_sub.set_label(_('CPU power limit {limit}').format(limit=levels[self.perf[1]][2]) +
                                    (' · ' + _('Fan Boost on') if boost == '1' else ''))
        else:
            self.mode_banner.add_css_class('unknown')
            self.mode_title.set_label(_('Custom mode'))
            self.mode_sub.set_label(_("The controller's setting wasn't recognized; choose a mode below"))

    def _apply_keys(self, data):
        kbd = data.get('kbd')
        if kbd is not None:
            self.kbd_toggle.set_active_name(str(min(kbd, 2)))
        fn = data.get('fn_lock')
        self.fn_row.set_visible(fn is not None)
        self.fn_row.set_active(fn == '1')
        lock = data.get('super_key_lock')
        self.super_row.set_visible(lock is not None)
        self.super_row.set_active(lock == '1')
        touchpad = data.get('touchpad_toggle_enable')
        self.touchpad_row.set_visible(touchpad is not None)
        self.touchpad_row.set_active(touchpad == '1')

    def _apply_power(self, data):
        profile = data.get('profile')
        self.profile_toggle.get_parent().set_sensitive(profile is not None)
        if profile:
            self.profile_toggle.set_active_name(profile)
            if data.get('performance_profile') is None:
                self.chip_profile.set_label({'power-saver': _('Power Saver'), 'balanced': _('Balanced'),
                                             'performance': _('Performance')}.get(profile, profile))
        for row, attr, options in ((self.priority_row, 'charging_priority', CHARGE_PRIORITIES),
                                   (self.profile_row, 'charging_profile', CHARGE_PROFILES)):
            value = data.get(attr)
            row.set_visible(value is not None)
            names = [n for n, _, _ in options]
            if value in names:
                row.set_selected(names.index(value))
                row.set_subtitle(options[names.index(value)][2])
        self.care_group.set_visible(self.priority_row.get_visible() or self.profile_row.get_visible())
        self.battery_profile_row.set_active('\nbalanced=huma-control-battery' in data.get('ppd', ''))
        ac, usb = data.get('ac_recover'), data.get('usb_powershare')
        self.ac_row.set_visible(ac is not None)
        self.ac_row.set_active(bool(ac))
        self.usb_row.set_visible(usb is not None)
        self.usb_row.set_active(usb == '1')
        self.off_group.set_visible(ac is not None or usb is not None)
        info, bat = data.get('battery'), data.get('bat')
        if info:
            r = self.bat_rows
            status = {'Charging': _('charging'), 'Discharging': _('discharging'), 'Full': _('full'),
                      'Not charging': _('not charging')}.get(info['status'], info['status'])
            r['charge'].set_subtitle(pct(f'{bat["percent"]:.0f}') + f' · {status}' if bat else status)
            r['capacity'].set_subtitle(f'{dec(info["full"])} Wh')
            r['design'].set_subtitle(f'{dec(info["design"])} Wh')
            r['health'].set_subtitle(pct(f'{100 * info["full"] / info["design"]:.0f}') if info['design'] else '—')
            r['cycles'].set_subtitle(str(info['cycles']) if info['cycles'] else _('Not reported by the controller'))
            r['tech'].set_subtitle(info['tech'] or '—')
        if 'card_off' in data:
            mode = 'off' if data['card_off'] else 'sleep' if data.get('card_reader') else 'on'
            i = [m for m, _, _ in CARD_MODES].index(mode)
