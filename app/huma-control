def usage_pids(key):
    """Currently running processes for a battery usage key (only the user's own processes)."""
    kind, _sep, ident = key.partition(':')
    pids = []
    if kind == 'app' and APP_SLICE.is_dir():
        for scope in APP_SLICE.iterdir():
            name = re.sub(r'\\x([0-9a-f]{2})', lambda m: chr(int(m.group(1), 16)), scope.name)
            m = (re.match(r'app-(?:gnome|flatpak)-(.+?)-\d+\.scope$', name) or
                 re.match(r'app-(.+?)(?:@[^.]*)?\.(?:scope|service)$', name) or
                 re.match(r'dbus-:[\d.]+-(.+?)@\d+\.service$', name))
            if m and m.group(1) == ident:
                try:
                    pids += (scope / 'cgroup.procs').read_text().split()
                except OSError:
                    pass
    elif kind == 'terminal':
        for pid in filter(str.isdigit, os.listdir('/proc')):
            try:
                if os.stat(f'/proc/{pid}').st_uid != os.getuid():
                    continue
                stat = Path(f'/proc/{pid}/stat').read_text()
                if stat[stat.index('(') + 1:stat.rindex(')')] == ident and \
                        '-spawn-' in Path(f'/proc/{pid}/cgroup').read_text():
                    pids.append(pid)
            except (OSError, ValueError):
                continue
    return pids


def process_info(pid):
    """(name, CPU time in s, memory in MB, command) or None."""
    try:
        stat = Path(f'/proc/{pid}/stat').read_text()
        fields = stat[stat.rindex(')') + 2:].split()
        cpu = (int(fields[11]) + int(fields[12])) / os.sysconf('SC_CLK_TCK')
        rss = next((int(line.split()[1]) for line in Path(f'/proc/{pid}/status').read_text().splitlines()
                    if line.startswith('VmRSS:')), 0) / 1024
        cmd = Path(f'/proc/{pid}/cmdline').read_bytes().replace(b'\0', b' ').decode(errors='replace').strip()
        return stat[stat.index('(') + 1:stat.rindex(')')], cpu, rss, cmd
    except (OSError, ValueError, IndexError):
        return None


def package_of(key, pids):
    """(description, GNOME Software argument) — where it was installed from."""
    kind, _sep, ident = key.partition(':')
    if kind == 'app' and subprocess.run(['flatpak', 'info', ident], capture_output=True).returncode == 0:
        return f'Flatpak: {ident}', f'--details={ident}'
    for pid in pids:
        try:
            exe = os.readlink(f'/proc/{pid}/exe')
        except OSError:
            continue
        r = subprocess.run(['rpm', '-qf', '--qf', '%{NAME}', exe], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return (_('Package: {name} (system package, dnf)').format(name=r.stdout.strip()),
                    f'--details-pkg={r.stdout.strip()}')
        return _('Not installed from a package: {path}').format(path=exe), None
    # if not running, use the package of the .desktop file
    try:
        info = DesktopAppInfo.new(ident + '.desktop') if kind == 'app' else None
    except TypeError:
        info = None
    if info and info.get_filename():
        r = subprocess.run(['rpm', '-qf', '--qf', '%{NAME}', info.get_filename()], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return (_('Package: {name} (system package, dnf)').format(name=r.stdout.strip()),
                    f'--details-pkg={r.stdout.strip()}')
    return _('No package information found'), None


def usage_entry(key):
    """Name and icon for a battery usage key (apps from their .desktop file)."""
    if key in USAGE_NAMES:
        name, icon = USAGE_NAMES[key]
        return name, Gio.ThemedIcon.new(icon), True
    kind, _sep, ident = key.partition(':')
    if kind == 'terminal':
        return _('Terminal: {name}').format(name=ident), Gio.ThemedIcon.new('utilities-terminal-symbolic'), True
    info = None
    for candidate in (ident, ident.lower()):
        try:
            info = DesktopAppInfo.new(candidate + '.desktop')
        except TypeError:
            info = None
        if info:
            break
    if info:
        return info.get_name(), info.get_icon() or Gio.ThemedIcon.new('application-x-executable-symbolic'), True
    return ident, Gio.ThemedIcon.new('application-x-executable-symbolic'), False
