    def _update_usage(self):
        data = read_json(USAGE_FILE)
        if not isinstance(data, dict):
            data = {}
        if self.usage_period == 'charge':
            since = (data.get('charge') or {}).get('start')
            totals = dict((data.get('charge') or {}).get('wh') or {})
            note = _('since {date}').format(date=since.replace('T', ' ')) if since else ''
        else:
            limit = time.strftime('%Y-%m-%dT%H', time.localtime(time.time() - 86400))
            totals = {}
            for hour, bucket in (data.get('hourly') or {}).items():
                if hour >= limit:
                    for key, wh in bucket.items():
                        totals[key] = totals.get(key, 0) + wh
            note = _('in the last 24 hours')
        for group, row in self.usage_rows:
            group.remove(row)
        self.usage_rows = []

        def add(group, row):
            group.add(row)
            self.usage_rows.append((group, row))
        total = sum(totals.values())
        self.system_usage_group.set_visible(total >= 0.01)
        if total < 0.01:
            add(self.usage_group, Adw.ActionRow(title=_('No data yet'),
                                                subtitle=_('Measured every minute while on battery')))
            return
        # apps the user opened (those with a .desktop file and terminal programs) are separate from the
        # system (screen, idle, desktop, background services); small shares go to "Other ..." in both
        user, system, small = [], {}, 0
        for key, wh in totals.items():
            name, icon, known = usage_entry(key)
            if known and (key.startswith('terminal:') or key.startswith('app:')):
                if wh / total >= 0.005:
                    user.append((key, name, icon, wh))
                else:
                    small += wh
                continue
            if not known or wh / total < 0.005:
                name, icon = _('Other background tasks'), Gio.ThemedIcon.new('application-x-executable-symbolic')
            entry = system.setdefault(name, [0, icon, key])
            entry[0] += wh
        user.sort(key=lambda x: -x[3])
        if small:
            user.append((None, _('Other apps'), Gio.ThemedIcon.new('application-x-executable-symbolic'), small))
        system = sorted(((v[2], name, v[1], v[0]) for name, v in system.items()), key=lambda x: -x[3])
        for group, items, actions in ((self.usage_group, user, True), (self.system_usage_group, system, False)):
            if not items:
                add(group, Adw.ActionRow(title=_('None'), subtitle=_('No app used the battery in this period')))
            for key, name, icon, wh in items[:12]:
                share = wh / total
                if share < 0.005:
                    continue
                row = Adw.ActionRow(title=name, subtitle=f'{pct(f"{share * 100:.0f}")} · {dec(wh, 2)} Wh',
                                    activatable=actions and key is not None)
                row.add_prefix(Gtk.Image(gicon=icon, pixel_size=32))
                row.add_suffix(Gtk.LevelBar(value=share, valign=Gtk.Align.CENTER, width_request=120))
                if row.get_activatable():
                    row.add_suffix(Gtk.Image(icon_name='go-next-symbolic'))
                    row.connect('activated', lambda _r, k=key, n=name, w=wh, sh=share: self._usage_details(k, n, w, sh))
                add(group, row)
        add(self.system_usage_group, Adw.ActionRow(title=_('Total {energy} Wh').format(energy=dec(total)), subtitle=note,
                                                   css_classes=['property']))

    def _usage_details(self, key, name, wh, share):
        """App details: processes, package; quit, force quit, uninstall."""
        pids = usage_pids(key)
        procs = [(pid, info) for pid in pids if (info := process_info(pid))]
        source, remove_arg = package_of(key, pids)
        lines = [_('Battery share: {percent} ({energy} Wh)').format(percent=pct(f'{share * 100:.0f}'),
                                                                     energy=dec(wh, 2)), source, '']
        if procs:
            lines.append(ngettext('Running process ({count}):', 'Running processes ({count}):',
                                  len(procs)).format(count=len(procs)))
            for pid, (comm, cpu, rss, cmd) in sorted(procs, key=lambda p: -p[1][1])[:8]:
                lines.append('  ' + _('{name} (PID {pid}) · CPU {cpu} s · memory {memory} MB').format(
                    name=comm, pid=pid, cpu=f'{cpu:.0f}', memory=f'{rss:.0f}'))
            lines.append('')
            lines.append(_('Command: {command}').format(command=procs[0][1][3][:160] or procs[0][1][0]))
        else:
            lines.append(_('Not running right now.'))
        dialog = Adw.AlertDialog(heading=name, body='\n'.join(lines))
        dialog.add_response('close', _('OK'))
        dialog.add_response('remove', _('Uninstall…'))
        dialog.add_response('kill', _('Force Quit'))
        dialog.add_response('term', _('Quit'))
        dialog.set_response_enabled('term', bool(procs))
        dialog.set_response_enabled('kill', bool(procs))
        dialog.set_response_enabled('remove', remove_arg is not None)
        dialog.set_response_appearance('kill', Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response('close')
        dialog.set_close_response('close')

        def done(_d, response):
            if response in ('term', 'kill'):
                sig = signal.SIGTERM if response == 'term' else signal.SIGKILL
                closed = 0
                for pid, _info in procs:
                    try:
                        os.kill(int(pid), sig)
                        closed += 1
                    except OSError:
                        pass
                if response == 'term':
                    text = ngettext('{name}: {count} process quit', '{name}: {count} processes quit', closed)
                else:
                    text = ngettext('{name}: {count} process killed', '{name}: {count} processes killed', closed)
                self.toast(text.format(name=name, count=closed))
            elif response == 'remove':
                # GNOME Software opens the app's page and asks for confirmation and authorization itself
                try:
                    subprocess.Popen(['gnome-software', remove_arg])
                except OSError:
                    self.toast(_('GNOME Software not found'))
        dialog.connect('response', done)
        dialog.present(self)

