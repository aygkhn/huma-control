    def show_page(self, name, select=True):
        name = PAGE_ALIASES.get(name, name)
        if name not in self.page_titles:
            return
        self.stack.set_visible_child_name(name)
        self.content_title.set_title(self.page_titles[name])
        if select:
            i = 0
            while (row := self.sidebar.get_row_at_index(i)) is not None:
                if row.page_name == name:
                    self.sidebar.select_row(row)
                    break
                i += 1
        if self.split.get_collapsed():
            self.split.set_show_sidebar(False)
        if name == 'history':
            self._load_history()
        elif name == 'keyboard':
            self._sync_kbd_texts(force=True)   # sunrise/sunset changes every day

