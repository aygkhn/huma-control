        table = self.curve_editor.table()
        self._curve_dirty = False
        self._updating = True
        self.curve_switch.set_active(True)
        self._updating = False
        self._run_root_async([HELPER, 'fan-curve', ','.join(map(str, table))], _('Custom fan curve applied'))

    def _apply_fan_curve(self, data):
        value = data.get('fan_curve')
        if not hasattr(self, 'curve_switch'):
            return
        self.curve_group.set_visible(value is not None)
        if value is None:
            return
        custom = value != 'auto'
        self.curve_switch.set_active(custom)
        if custom and not self._curve_dirty:
            try:
                self.curve_editor.set_table([int(x) for x in value.split()])
                self.curve_base.set_value(self.curve_editor.base)
                self._curve_dirty = False
            except ValueError:
                pass

