"""Huma Control Center system service: automatic profiles, history logging and alerts.

Runs as root from boot, independent of any session (also on the login screen).

Automatic profiles (/etc/huma-control/automation.json, written by Huma Control Center through
  huma-control-helper; off by default):
  priority: running app rule > night hours > on AC / on battery. When the matching rule changes
  it writes the driver's performance_profile; when no rule matches it returns to the profile in
  use before the rules. If the user changes it by hand, it is left alone until conditions change.

History (/var/lib/huma-control/history.csv): once a minute AC, battery, power, temperature,
  fan, profile and battery capacity; entries older than 90 days are removed. Written to disk in
  batches every 10 minutes (and on stop).

Power saving: every read of a qc71 sysfs file is a WMI access to the embedded controller (EC)
  (~61 ms, ~39 EC interrupts; performance_profile takes 3 calls). So the loop runs every 15 s
  (5 s above 85 °C), AC and profile changes are learned from kernel uevents without waiting,
  the profile is read only when it changes, fan speed every 5 minutes on battery (every minute
  when hot), fan fault every 10 minutes (every minute above 80 °C).

Battery usage (/var/lib/huma-control/battery-usage.json): per-app share, like on Android,
  an estimate. Only on battery, once a minute: the estimated screen share and the idle baseline are
  subtracted from the measured power, the rest is split among apps in proportion to CPU (cgroup
  cpu.stat) and GPU (DRM fdinfo) usage. Every app launched from GNOME has its own cgroup;
  programs running in terminal tabs are counted separately. Kept since the last charge and
  hourly (7 days).

Alerts (/run/huma-control/alerts.json): overheating, fan fault, fan not spinning while
  hot, battery health below 80%. The Huma Control Center extension shows them as desktop
  notifications.

  huma-control-service              run the service
  huma-control-service --validate   validate the automatic profile settings on stdin, print
                                    clean JSON
"""
import errno
import json
import os
import re
import select
import signal
import socket
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

QC71 = Path('/sys/devices/platform/qc71_laptop')
BAT = Path('/sys/class/power_supply/BAT0')
CONFIG = Path('/etc/huma-control/automation.json')
HISTORY = Path('/var/lib/huma-control/history.csv')
ALERTS = Path('/run/huma-control/alerts.json')
STATE = Path('/run/huma-control/automation-state.json')
PROFILES = ['balanced-low', 'balanced-medium', 'balanced-high', 'quiet-20db', 'quiet-30db', 'quiet-40db']
HISTORY_DAYS = 90
TICK = 15           # s: normal loop interval
TICK_HOT = 5        # s: when hot (the 95 °C alert needs 30 s of sustained heat, sample often)
HOT_C = 85          # TICK_HOT from this temperature on
HISTORY_EVERY = 60  # s
FLUSH_EVERY = 600   # s: history and battery usage are buffered in memory, written to disk at this interval
FAN_EVERY_BATTERY = 300  # s: fan speed read interval on battery (every minute on AC)
FAN_WARM_C = 60     # from this temperature on, fan speed is read on every record
FAULT_EVERY = 600   # s: fan fault read interval
FAULT_HOT_C = 80    # from this temperature on, fan fault is read on every record
# Battery voltage guard (3S pack, rest voltage). The gauge's 5% is ~10.3 V; the pack cut power at ~9.5 V.
# {"enabled": bool, "sleep_volts": V}, written by huma-control-power (Battery page)
GUARD_CONFIG = Path('/etc/huma-control/battery-guard.json')
GUARD_DEFAULT = {'enabled': True, 'sleep_volts': 10.3}
GUARD_VOLTS = (10.0, 11.0)
LOW_V_WARN_ABOVE = 0.3   # V: alert this much above the sleep voltage
LOW_V_NEAR_ABOVE = 0.5   # V: from this much above the sleep voltage, check every round
LOW_V_ROUNDS = 2    # consecutive readings (a short load spike does not count)
PACK_OHM = 0.27     # measured pack internal resistance (Ω)
FIELDS ='time,ac,battery,watts,cpu_c,fan_rpm,profile,full_wh,design_wh'

DEFAULT = {
    'enabled': False,
    'on_ac': '',
    'on_battery': '',
    'night': {'enabled': False, 'start': '23:00', 'end': '07:00', 'profile': 'quiet-20db'},
    'apps': [],
}


def log(text):
    print(text, flush=True)


def read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def hwmon(name):
    for h in Path('/sys/class/hwmon').iterdir():
        if read(h / 'name') == name:
            return h
    return None


_HWMON = {}   # (names, file) → path; avoid scanning hwmon names on every read


def hwmon_value(names, attr):
    """Value from the first matching hwmon; the path is cached and looked up again if it cannot
    be read (driver reloaded, number changed)."""
    key = (names, attr)
    path = _HWMON.get(key)
    value = read(path) if path else None
    if value is None:
        path = None
        for name in names:
            h = hwmon(name)
            if h:
                path = h / attr
                break
        _HWMON[key] = path
        value = read(path) if path else None
    return value


# ------------------------------------------------------------------ settings

# a broken settings file must never bring the service down (systemd would keep restarting it)
CONFIG_ERRORS = (OSError, ValueError, TypeError, AttributeError)


def validate(data):
    """Validate the settings, fill in missing fields with defaults; ValueError if invalid."""
    if not isinstance(data, dict):
        raise ValueError('settings must be an object')
    out = json.loads(json.dumps(DEFAULT))
    out['enabled'] = bool(data.get('enabled', False))
    for key in ('on_ac', 'on_battery'):
        value = data.get(key, '') or ''
        if value and (not isinstance(value, str) or value not in PROFILES):
            raise ValueError(f'{key}: unknown profile {value}')
        out[key] = value
    night = data.get('night') or {}
    if not isinstance(night, dict):
        raise ValueError('night must be an object')
    for key in ('start', 'end'):
        value = night.get(key, out['night'][key])
        if not re.fullmatch(r'([01]\d|2[0-3]):[0-5]\d', str(value)):
            raise ValueError(f'night.{key}: must be HH:MM')
        out['night'][key] = value
    out['night']['enabled'] = bool(night.get('enabled', False))
    profile = night.get('profile', out['night']['profile'])
    if not isinstance(profile, str) or profile not in PROFILES:
        raise ValueError('night.profile: unknown profile')
    out['night']['profile'] = profile
    rules = data.get('apps') or []
    if not isinstance(rules, list) or len(rules) > 20:
        raise ValueError('apps: at most 20 rules')
    for rule in rules:
        if not isinstance(rule, dict):
            raise ValueError('app rule must be an object')
        name, match, profile = str(rule.get('name', ''))[:60], str(rule.get('match', ''))[:120], rule.get('profile')
        # app_id: ID of an app launched from GNOME (.desktop name, e.g. org.mozilla.firefox)
        app_id = str(rule.get('app_id', '') or '')[:120].strip()
        if app_id and not re.fullmatch(r'[\w.\-]+', app_id):
            raise ValueError(f'invalid app ID: {app_id}')
        if not (match.strip() or app_id) or not isinstance(profile, str) or profile not in PROFILES:
            raise ValueError('incomplete app rule')
        battery_only = rule.get('battery_only', False)
        if not isinstance(battery_only, bool):
            raise ValueError('battery_only must be true/false')
        item = {'name': name or app_id or match, 'match': match.strip(), 'profile': profile, 'battery_only': battery_only}
        if app_id:
            item['app_id'] = app_id
        out['apps'].append(item)
    return out


def load_config():
    try:
        return validate(json.loads(CONFIG.read_text()))
    except CONFIG_ERRORS as e:
        if CONFIG.exists():
            log(f'could not read settings: {e}')
        return json.loads(json.dumps(DEFAULT))


# ------------------------------------------------------------------ automatic profiles

def running_commands():
    """Command lines of running processes (lowercase)."""
    out = []
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            raw = Path(f'/proc/{pid}/cmdline').read_bytes()
        except OSError:
            continue
        if raw:
            out.append(raw.replace(b'\0', b' ').decode(errors='replace').lower())
    return out


def running_apps():
    """IDs of apps launched from GNOME (lowercase): each has its own cgroup
    (app-gnome-org.mozilla.firefox-1234.scope); more reliable than the command line."""
    out = set()
    try:
        for scope in CGROUP.glob('user.slice/user-*.slice/user@*.service/app.slice/app-*'):
            m = re.match(r'app-(?:gnome|flatpak)-(.+?)-\d+\.scope$', unescape(scope.name))
            if m:
                out.add(m.group(1).lower())
    except OSError:
        pass
    return out


def in_window(start, end, now):
    s = int(start[:2]) * 60 + int(start[3:])
    e = int(end[:2]) * 60 + int(end[3:])
    m = now.hour * 60 + now.minute
    return s <= m < e if s <= e else (m >= s or m < e)


_MAINS = None   # the AC adapter's 'online' file (kept once found)


def on_mains():
    """On AC? Reading 'online' is ACPI _PSR (~4 EC interrupts); called at most once per round."""
    global _MAINS
    if _MAINS:
        value = read(_MAINS)
        if value is not None:
            return value == '1'
    for ps in Path('/sys/class/power_supply').iterdir():
        if read(ps / 'type') == 'Mains':
            _MAINS = ps / 'online'
            return read(_MAINS) == '1'
    _MAINS = None
    return True


class Profile:
    """performance_profile cache: a read is 3 WMI calls (~116 EC interrupts). Read once when
    needed at start, after our own writes and when the driver announces a change (uevent
    HUMA_CONTROL=performance). Without a uevent socket (live=False) it is read every time."""

    def __init__(self):
        self.value = None
        self.dirty = True
        self.live = False

    def get(self):
        if self.dirty or not self.live:
            self.value = read(QC71 / 'performance_profile')
            self.dirty = self.value is None   # without the driver reading is cheap; retry once it loads
        return self.value


NETLINK_KOBJECT_UEVENT = 15   # linux/netlink.h (missing from Python's socket module)


# At boot tuned often applies its profile before the driver is loaded: platform_profile does not
# exist yet, so the power mode stays at the controller's default (Balanced Medium, 32 W) even on
# battery with Power Saver selected. When the driver appears, ask tuned to apply its current
# profile again (D-Bus 'reload' keeps the selected profile and the automatic mode).
PLATFORM_PROFILE = Path('/sys/firmware/acpi/platform_profile')
TUNED_RELOAD_TRIES = 12   # tuned may still be starting: retry every 5 s for a minute


def tuned_reload():
    try:
        out = subprocess.run(['busctl', 'call', '--timeout=10', 'com.redhat.tuned', '/Tuned',
                              'com.redhat.tuned.control', 'reload'],
                             capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False
    return out.returncode == 0 and out.stdout.strip() == 'b true'


class Uevents:
    """Kernel uevents (NETLINK_KOBJECT_UEVENT): AC plug/unplug (power_supply) and the driver's
    profile announcement (/devices/platform/qc71_laptop, HUMA_CONTROL=performance) arrive
    without waiting for the loop round. OSError if the socket cannot be opened; the loop then
    falls back to reading every round."""

    def __init__(self):
        self.sock = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM | socket.SOCK_NONBLOCK | socket.SOCK_CLOEXEC,
                                  NETLINK_KOBJECT_UEVENT)
        self.sock.bind((0, 1))   # 1: the kernel's broadcast group (without waiting for udev)
        self.poll = select.poll()
        self.poll.register(self.sock, select.POLLIN)

    def wait(self, timeout):
        """Wait at most timeout s. Returns {'mains': True/False/None (changed, value unknown),
        'profile': True, 'lost': True (events lost, re-read everything)}; empty on timeout."""
        out = {}
        if not self.poll.poll(max(0, int(timeout * 1000))):
            return out
        while True:
            try:
                data, (pid, _) = self.sock.recvfrom(16384)
            except BlockingIOError:
                break
            except OSError as e:
                if e.errno != errno.ENOBUFS:
                    raise
                out['lost'] = True
                continue
            if pid != 0:   # only from the kernel
                continue
            env = dict(p.split(b'=', 1) for p in data.split(b'\0')[1:] if b'=' in p)
            if env.get(b'SUBSYSTEM') == b'power_supply' and env.get(b'POWER_SUPPLY_TYPE') == b'Mains':
                online = env.get(b'POWER_SUPPLY_ONLINE')
                out['mains'] = online == b'1' if online in (b'0', b'1') else None
            elif env.get(b'DEVPATH') == b'/devices/platform/qc71_laptop':
                # driver loaded or profile changed (fan_boost is not a profile)
                if env.get(b'HUMA_CONTROL') == b'performance' or env.get(b'ACTION') in (b'add', b'bind'):
                    out['profile'] = True
                if env.get(b'ACTION') in (b'add', b'bind'):
                    out['driver'] = True
        return out


class Auto:
    def __init__(self, mains, profile):
        self.applied = None       # last applied (reason, profile, reason code, data)
        self.before = None        # profile before the rules
        self.mains = mains
        self.profile = profile    # performance_profile cache
        self.reapply_at = 0

    def busy(self, config):
        """Is a tick needed this round? When off, only to return to the previous profile or for a
        pending re-apply."""
        return config['enabled'] or self.applied is not None or bool(self.reapply_at)

    def desired(self, config, mains):
        """Matching rule as (reason text, profile, reason code, data) or None. The English
        reason text is for the log and other tools; the app and extension translate from the
        code and data (see STATE)."""
        if not config['enabled']:
            return None
        rules = [r for r in config['apps'] if not (r.get('battery_only') and mains)]
        if rules:
            commands = running_commands() if any(r['match'] for r in rules) else []
            apps = running_apps() if any(r.get('app_id') for r in rules) else set()
            for rule in rules:
                needle = rule['match'].lower()
                if (rule.get('app_id', '').lower() in apps or
                        (needle and any(needle in c for c in commands))):
                    return (f"app: {rule['name']}", rule['profile'], 'app', {'name': rule['name']})
        night = config['night']
        if night['enabled'] and in_window(night['start'], night['end'], datetime.now()):
            return ('night hours', night['profile'], 'night', {})
        profile = config['on_ac'] if mains else config['on_battery']
        if profile:
            return ('on AC' if mains else 'on battery', profile, 'ac' if mains else 'battery', {})
        return None

    def write(self, profile):
        try:
            (QC71 / 'performance_profile').write_text(profile)
            return True
        except OSError as e:
            log(f'could not write profile ({profile}): {e}')
            return False
        finally:
            self.profile.dirty = True   # the driver's current value is re-read when needed

    def tick(self, config, mains):
        now = time.monotonic()
        if mains != self.mains:
            # tuned also writes the power mode when AC changes; re-apply after it
            self.mains = mains
            self.reapply_at = now + 4
        want = self.desired(config, mains)
        force = self.reapply_at and now >= self.reapply_at
        if force:
            self.reapply_at = 0
        if want == self.applied and not force:
            return
        if want is None:
            if self.applied is not None and self.before:
                log(f'no rule applies: returning to profile {self.before}')
                self.write(self.before)
            self.applied, self.before = None, None
        else:
            if self.applied is None:
                self.before = self.profile.get()
                if self.before not in PROFILES:
                    self.before = None
            if want != self.applied:
                log(f'{want[0]} → {want[1]}')
            if self.write(want[1]):
                self.applied = want
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(json.dumps({'reason': self.applied[0] if self.applied else None,
                                         'reason_code': self.applied[2] if self.applied else None,
                                         'data': self.applied[3] if self.applied else None,
                                         'profile': self.applied[1] if self.applied else None},
                                        ensure_ascii=False))
        except OSError:
            pass


# ------------------------------------------------------------------ history

def battery_watts():
    """Battery power (W; negative while discharging). power_now if current_now/voltage_now are missing."""
    sign = -1 if read(BAT / 'status') == 'Discharging' else 1
    try:
        cur, volt = read(BAT / 'current_now'), read(BAT / 'voltage_now')
        if cur and volt:
            return sign * int(cur) * int(volt) / 1e12
    except ValueError:
        pass
    try:
        power = read(BAT / 'power_now')
        return sign * int(power) / 1e6 if power else None
    except ValueError:
        return None


def battery_volts():
    """Battery rest voltage estimate (V): measured voltage plus the internal-resistance drop under load."""
    try:
        volt = int(read(BAT / 'voltage_now', '0') or 0) / 1e6
        cur = int(read(BAT / 'current_now', '0') or 0) / 1e6
    except ValueError:
        return None
    return volt + cur * PACK_OHM if volt else None


class VoltageGuard:
    """The charge gauge can drift (e.g. after charge-limit changes) and still show 13% on an empty
    battery; the pack then cuts power without warning. On battery, warn and then suspend by voltage."""

    def __init__(self):
        self.low = 0             # consecutive readings under the sleep voltage
        self.volts = None
        self.resume_at = 0       # after a suspend: give time to plug in before suspending again
        self.config, self.mtime = dict(GUARD_DEFAULT), object()

    def load(self):
        try:
            mtime = GUARD_CONFIG.stat().st_mtime
        except OSError:
            mtime = None
        if mtime == self.mtime:
            return
        self.mtime, config = mtime, dict(GUARD_DEFAULT)
        if mtime is not None:
            try:
                data = json.loads(GUARD_CONFIG.read_text())
                config['enabled'] = bool(data.get('enabled', True))
                volts = float(data.get('sleep_volts', config['sleep_volts']))
                if GUARD_VOLTS[0] <= volts <= GUARD_VOLTS[1]:
                    config['sleep_volts'] = volts
            except CONFIG_ERRORS as e:
                log(f'battery guard settings could not be read ({e}); defaults are used')
        self.config = config
        log(f"battery guard: {'sleep at %.2f V' % config['sleep_volts'] if config['enabled'] else 'off'}")

    def due(self, history_due):
        # every minute normally; every round near empty
        near = self.config['sleep_volts'] + LOW_V_NEAR_ABOVE
        return history_due or (self.volts is not None and self.volts < near)

    def tick(self, mains, alerts):
        self.load()
        if not self.config['enabled'] or mains or read(BAT / 'status') != 'Discharging':
            self.low, self.volts = 0, None
            return
        self.volts = volts = battery_volts()
        if volts is None:
            return
        sleep_volts = self.config['sleep_volts']
        if volts < sleep_volts + LOW_V_WARN_ABOVE:
            alerts.raise_('battery_empty', 'battery-empty', 'Battery is almost empty',
                          'Battery at {volts} V, the percentage may be wrong. Plug in the charger; '
                          'the computer will sleep at {sleep_volts} V.',
                          {'volts': round(volts, 2), 'sleep_volts': round(sleep_volts, 2)}, 600)
        self.low = self.low + 1 if volts < sleep_volts else 0
        if self.low >= LOW_V_ROUNDS and time.monotonic() >= self.resume_at:
            log(f'battery at {volts:.2f} V ({read(BAT / "capacity", "?")}%): suspending')
            self.low = 0
            subprocess.run(['systemctl', 'suspend'], check=False)
            self.resume_at = time.monotonic() + 120


def battery_wh():
    volts = int(read(BAT / 'voltage_min_design', '0') or 0) / 1e6
    full, design = read(BAT / 'charge_full'), read(BAT / 'charge_full_design')
    if full and design and volts:
        return int(full) / 1e6 * volts, int(design) / 1e6 * volts
    full, design = read(BAT / 'energy_full'), read(BAT / 'energy_full_design')
    if full and design:
        return int(full) / 1e6, int(design) / 1e6
    return None, None


def cpu_temp():
    value = hwmon_value(('coretemp', 'k10temp'), 'temp1_input')
    return int(value) / 1000 if value else None


def fan_rpm():
    """Fan speed; every read is an EC WMI access (~39 interrupts)."""
    value = hwmon_value(('qc71_laptop.hwmon.fan',), 'fan1_input')
    return int(value) if value else None


def fmt(v, spec='.1f'):
    return '' if v is None else format(v, spec)


_PENDING = []   # history lines waiting to be written to disk


def record(sample):
    """Buffer the line in memory; flush_history() writes it (so the disk does not wake every minute)."""
    _PENDING.append(','.join(sample))


def flush_history():
    if not _PENDING:
        return
    try:
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        new = not HISTORY.exists()
        with HISTORY.open('a') as f:
            if new:
                f.write(FIELDS + '\n')
            f.write('\n'.join(_PENDING) + '\n')
        _PENDING.clear()
    except OSError as e:
        log(f'could not write history: {e}')
        del _PENDING[:-1440]   # if it cannot be written, keep at most one day in memory


def prune():
    """Remove lines older than 90 days."""
    flush_history()
    try:
        lines = HISTORY.read_text().splitlines()
    except OSError:
        return
    limit = (datetime.now() - timedelta(days=HISTORY_DAYS)).strftime('%Y-%m-%dT%H:%M')
    kept = [lines[0]] + [l for l in lines[1:] if l[:16] >= limit]
    if len(kept) < len(lines):
        tmp = HISTORY.with_suffix('.tmp')
        tmp.write_text('\n'.join(kept) + '\n')
        tmp.replace(HISTORY)


# ------------------------------------------------------------------ alerts

class Alerts:
    """Each alert has an English 'title'/'text' (for the log and other tools) plus a stable
    'code' and the 'data' values used in the text, so the app and extension can translate."""

    def __init__(self):
        self.items = []
        self.next_id = int(time.time())
        self.last = {}          # kind -> time of the last alert
        self.hot_since = None
        self.stuck_since = None

    def raise_(self, kind, code, title, text, data, cooldown):
        now = time.monotonic()
        if now - self.last.get(kind, -1e9) < cooldown:
            return
        self.last[kind] = now
        self.next_id += 1
        self.items.append({'id': self.next_id, 'kind': kind, 'code': code,
                           'time': datetime.now().isoformat(timespec='seconds'),
                           'title': title, 'text': text.format(**data), 'data': data})
        self.items = self.items[-20:]
        log(f'alert: {title}')
        try:
            ALERTS.parent.mkdir(parents=True, exist_ok=True)
            tmp = ALERTS.with_suffix('.tmp')
            tmp.write_text(json.dumps({'alerts': self.items}, ensure_ascii=False))
            os.chmod(tmp, 0o644)
            tmp.replace(ALERTS)
        except OSError as e:
            log(f'could not write alerts: {e}')

    def check(self, temp, rpm=None, full_wh=None, design_wh=None, fault=None):
        """rpm/fault None: not read this round (the EC is not queried every round), that check is skipped."""
        now = time.monotonic()
        if temp is not None and temp >= 95:
            self.hot_since = self.hot_since or now
            if now - self.hot_since >= 30:
                self.raise_('overheat', 'overheat', 'CPU is overheating',
                            'CPU at {temp} °C. Make sure the air vents are not blocked; '
                            'Fan Boost can be turned on from the Performance page.', {'temp': round(temp)}, 600)
        else:
            self.hot_since = None
        if fault:
            self.raise_('fan_fault', 'fan-fault', 'Fan failure',
                        'The controller reports a fan failure (the fan is not spinning or is stuck).', {}, 3600)
        if rpm is None and temp is not None and temp >= 80:
            pass    # fan not read this round: do not reset the timer
        elif temp is not None and rpm == 0 and temp >= 80:
            self.stuck_since = self.stuck_since or now
            if now - self.stuck_since >= 60:
                self.raise_('fan_stuck', 'fan-stuck', 'Fan is not spinning',
                            'The fan is stopped although the CPU is at {temp} °C.', {'temp': round(temp)}, 1800)
        else:
            self.stuck_since = None
        if full_wh and design_wh and full_wh / design_wh < 0.8:
            self.raise_('battery_health', 'battery-health', 'Battery health has dropped',
                        'When full, the battery holds {full_wh} Wh (design {design_wh} Wh, {percent}%). '
                        '"Balanced" or "Stationary" in Battery Care protects the battery.',
                        {'full_wh': round(full_wh, 1), 'design_wh': round(design_wh, 1),
                         'percent': round(100 * full_wh / design_wh)}, 86400 * 7)


