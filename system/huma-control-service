USAGE = Path('/var/lib/huma-control/battery-usage.json')
# Since when on battery (last unplug): {"mains": false, "since": epoch s, "percent": %, "boot_id": ..,
# "asleep": s}. asleep = CLOCK_BOOTTIME - CLOCK_MONOTONIC at unplug: the time spent suspended since
# then is the growth of this difference (same boot only). Read by the app and the extensions.
ON_BATTERY = Path('/var/lib/huma-control/on-battery.json')
# Typical power on battery (median of the last 14 days of battery samples): the app and the
# extensions show "on this charge the battery lasts ~X" while plugged in. {"typical_w": W, "samples": n}
ESTIMATE = Path('/var/lib/huma-control/battery-estimate.json')
ESTIMATE_DAYS = 14
ESTIMATE_EVERY = 3600   # s


def write_estimate():
    flush_history()
    limit = (datetime.now() - timedelta(days=ESTIMATE_DAYS)).strftime('%Y-%m-%dT%H:%M')
    watts = []
    try:
        with HISTORY.open() as f:
            next(f, None)
            for line in f:
                cols = line.split(',')
                if len(cols) > 3 and cols[0] >= limit and cols[1] == '0' and cols[3]:
                    try:
                        w = -float(cols[3])
                    except ValueError:
                        continue
                    if w > 0:
                        watts.append(w)
    except OSError:
        return
    if len(watts) < 60:   # less than an hour on battery: no estimate yet
        return
    watts.sort()
    try:
        tmp = ESTIMATE.with_suffix('.tmp')
        tmp.write_text(json.dumps({'typical_w': round(watts[len(watts) // 2], 2), 'samples': len(watts)}))
        os.chmod(tmp, 0o644)
        tmp.replace(ESTIMATE)
    except OSError as e:
        log(f'could not write {ESTIMATE.name}: {e}')


# Own energy counter: the charge gauge drifts (with "Balanced"/"Stationary" it jumps from ~94% to
# 100% when charging stops, and corrects itself only near empty). Counted from the last "Full":
# energy drawn (battery V×I; across a suspend the gauge's charge counter), minus energy charged.
# Read by the app and the extensions: {"remaining_wh", "full_wh", "percent", "source": "counter" |
# "voltage", "avg_w" (recent power on battery), "profile", "full_at", "updated", "learned": {profile: Wh}}
ENERGY = Path('/var/lib/huma-control/battery-energy.json')
# usable energy from full to empty per charging profile (Wh), measured on the original 53 Wh pack
# (2026-10-03/05); "stationary" is estimated. Replaced by the learned value once the battery has
# been run to the sleep voltage from full.
FULL_WH = {'high_capacity': 46.5, 'balanced': 41.5, 'stationary': 38.0}
CHARGE_EFFICIENCY = 0.94   # share of the battery's input power that is stored (internal resistance)
# rest voltage (V, load-corrected) -> energy left (Wh), measured 2026-10-05 near empty. Only the
# last ~10%: higher up the curve is flat and a load step moves the voltage more than the charge does
VOLT_WH = [(10.5, 0.5), (10.6, 0.6), (10.7, 0.8), (10.8, 1.1), (10.9, 1.7), (11.0, 2.3), (11.1, 4.1)]
VOLT_SMOOTH = 0.3   # voltage average weight per reading (≈3 min): a short load spike does not count
GAP = 150   # s: a longer gap between readings is a suspend (or the service was stopped)


def volt_wh(volts):
    if volts is None or volts >= VOLT_WH[-1][0]:
        return None
    if volts <= VOLT_WH[0][0]:
        return VOLT_WH[0][1]
    for (v1, w1), (v2, w2) in zip(VOLT_WH, VOLT_WH[1:]):
        if volts <= v2:
            return w1 + (w2 - w1) * (volts - v1) / (v2 - v1)


class EnergyMeter:
    def __init__(self):
        try:
            self.data = json.loads(ENERGY.read_text())
        except (OSError, ValueError):
            self.data = {}
        self.data.setdefault('learned', {})
        self.last = None    # (CLOCK_BOOTTIME, watts, charge_now µAh)
        self.volts = None   # smoothed load-corrected voltage while discharging

    def full_wh(self, profile):
        learned = self.data['learned'].get(profile)
        return learned or FULL_WH.get(profile, FULL_WH['balanced'])

    def tick(self, status, watts, sleep_volts):
        now = time.clock_gettime(time.CLOCK_BOOTTIME)
        profile = read(QC71 / 'charging_profile') or 'balanced'
        charge = read(BAT / 'charge_now')
        charge = int(charge) if charge and charge.isdigit() else None
        last, self.last = self.last, (now, watts, charge)
        d = self.data
        # counter_wh: energy left by the counter alone (may go below 0 if the battery holds more
        # than assumed: used for learning); remaining_wh: what is shown (counter, or the voltage
        # near empty when it says less)
        if status == 'Full':
            if d.get('state') != 'full':
                d.update(state='full', full_at=round(time.time()), profile=profile)
            d['counter_wh'] = d['full_wh'] = self.full_wh(profile)
            d['profile'] = profile
        elif 'counter_wh' not in d:
            # no full charge seen yet: start from the gauge, corrected by the voltage near empty
            full = self.full_wh(profile)
            try:
                d.update(counter_wh=full * int(read(BAT / 'capacity', '0')) / 100, full_wh=full,
                         profile=profile, state='estimated')
            except ValueError:
                return
        elif last and watts is not None and last[1] is not None:
            dt = now - last[0]
            if d.get('state') == 'full':
                d['state'] = 'counting'
            if dt <= GAP:
                energy = (last[1] + watts) / 2 * dt / 3600   # negative while discharging
            elif charge is not None and last[2] is not None:
                volts = int(read(BAT / 'voltage_now', '0') or 0) / 1e6
                energy = (charge - last[2]) / 1e6 * volts
            else:
                energy = 0
            if energy > 0:
                energy *= CHARGE_EFFICIENCY
            d['counter_wh'] = min(d['full_wh'], d['counter_wh'] + energy)
        remaining, d['source'] = max(0.0, d['counter_wh']), 'counter'
        if status == 'Discharging':
            # recent power (≈5 min average) for the time left
            if watts is not None and watts < 0:
                d['avg_w'] = round(-watts if d.get('avg_w') is None else d['avg_w'] * 0.8 - watts * 0.2, 2)
            volts = battery_volts()
            if volts is not None:
                self.volts = volts if self.volts is None else self.volts + (volts - self.volts) * VOLT_SMOOTH
            by_volts = volt_wh(self.volts)
            if by_volts is not None and by_volts < remaining:
                remaining, d['source'] = by_volts, 'voltage'
            # ran from full down to the sleep voltage: learn the usable energy of this profile
            if (volts is not None and volts < sleep_volts and d.get('state') == 'counting'
                    and d.get('learned_at') != d.get('full_at')):
                used = d['full_wh'] - d['counter_wh'] + VOLT_WH[0][1]
                old = self.full_wh(d['profile'])
                d['learned_at'] = d.get('full_at')
                if 0.6 * old < used < 1.4 * old:
                    new = round(old * 0.5 + used * 0.5, 1)
                    d['learned'][d['profile']] = new
                    log(f"battery energy: {d['profile']} held {used:.1f} Wh, learned {new} Wh")
        else:
            d['avg_w'] = self.volts = None
        d['remaining_wh'] = round(remaining, 2)
        d['counter_wh'] = round(d['counter_wh'], 3)
        d['percent'] = round(100 * remaining / d['full_wh']) if d.get('full_wh') else None
        d['updated'] = round(time.time())
        self.write()

    def write(self):
        try:
            tmp = ENERGY.with_suffix('.tmp')
            tmp.write_text(json.dumps(self.data))
            os.chmod(tmp, 0o644)
            tmp.replace(ENERGY)
        except OSError as e:
            log(f'could not write {ENERGY.name}: {e}')


def asleep_s():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)


class Unplugged:
    def __init__(self):
        self.mains = None
        try:
            self.data = json.loads(ON_BATTERY.read_text())
        except (OSError, ValueError):
            self.data = {}

    def note(self, mains):
        if mains is None or mains == self.mains:
            return
        first, self.mains = self.mains is None, mains
        # service (re)started on battery: keep the unplug time that was already written
        if first and not mains and self.data.get('mains') is False:
            return
        self.data = {'mains': True} if mains else {
            'mains': False, 'since': round(time.time()), 'percent': int(read(BAT / 'capacity', '0') or 0),
            'boot_id': read('/proc/sys/kernel/random/boot_id', ''), 'asleep': round(asleep_s())}
        if first and not mains:
            self.from_history()
        self.write()

    def from_history(self):
        """Started on battery without a record (first run): take the unplug time and percentage
        from the history (first battery row after the last AC row); time asleep is then unknown."""
        try:
            rows = HISTORY.read_text().splitlines()[1:]
        except OSError:
            return
        last = None
        for i in range(len(rows) - 1, -1, -1):
            if rows[i].split(',')[1:2] == ['1']:
                last = i
                break
        if last is None or last + 1 >= len(rows):
            return
        row = rows[last + 1].split(',')
        try:
            self.data.update(since=round(datetime.fromisoformat(row[0]).timestamp()), percent=int(row[2]))
        except (ValueError, IndexError):
            return
        self.data.pop('asleep', None)

    def write(self):
        try:
            tmp = ON_BATTERY.with_suffix('.tmp')
            tmp.write_text(json.dumps(self.data))
            os.chmod(tmp, 0o644)
            tmp.replace(ON_BATTERY)
        except OSError as e:
            log(f'could not write {ON_BATTERY.name}: {e}')


# Battery usage file: {"charge": {"start": "YYYY-MM-DDTHH:MM", "percent": capacity at unplug,
# "wh": {key: Wh}}, "hourly": {"YYYY-MM-DDTHH": {key: Wh}}, "baseline": {"YYYY-MM-DD": W}};
# keys: "app:<desktop id>", "terminal:<process>", "screen", "system", "desktop" (GNOME Shell)
CGROUP = Path('/sys/fs/cgroup')
PANEL = Path('/sys/class/drm')
USAGE_DAYS = 7
GPU_RESCAN = 600    # s: processes using the GPU are rescanned at this interval


def unescape(name):
    return re.sub(r'\\x([0-9a-f]{2})', lambda m: chr(int(m.group(1), 16)), name)


def app_key(path):
    """App key from a cgroup path; None: count process by process (terminal tab)."""
    name = unescape(path.name)
    parts = path.parts
    if 'app.slice' in parts:
        if re.match(r'(ptyxis|vte|gnome-terminal|kgx)-spawn-', name):
            return None
        m = (re.match(r'app-(?:gnome|flatpak)-(.+?)-\d+\.scope$', name) or re.match(r'app-(.+?)(?:@[^.]*)?\.(?:scope|service)$', name)
             or re.match(r'dbus-:[\d.]+-(.+?)@\d+\.service$', name))
        return f'app:{m.group(1)}' if m else f'app:{name.rsplit(".", 1)[0]}'
    if name.startswith('org.gnome.Shell@'):
        return 'desktop'
    return 'system'


def leaf_cgroups():
    """Leaf cgroups containing processes (apps, session and system services)."""
    for root, dirs, files in os.walk(CGROUP):
        if not dirs or not any(d.endswith(('.slice', '.service', '.scope')) for d in dirs):
            if 'cpu.stat' in files:
                yield Path(root)


def cpu_usec(cg):
    try:
        for line in (cg / 'cpu.stat').read_text().splitlines():
            if line.startswith('usage_usec'):
                return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def proc_cpu(cg):
    """CPU time (microseconds) of processes in a terminal tab, keyed by process name."""
    out = {}
    tick = os.sysconf('SC_CLK_TCK')
    try:
        pids = (cg / 'cgroup.procs').read_text().split()
    except OSError:
        return out
    for pid in pids:
        try:
            stat = Path(f'/proc/{pid}/stat').read_text()
            comm = stat[stat.index('(') + 1:stat.rindex(')')]
            fields = stat[stat.rindex(')') + 2:].split()
            out[(pid, comm)] = (int(fields[11]) + int(fields[12]) + int(fields[13]) + int(fields[14])) * 1e6 / tick
        except (OSError, ValueError, IndexError):
            continue
    return out


def gpu_pids():
    """Processes with a GPU (DRM) file open: {pid: (DRM fd numbers)}."""
    found = {}
    for pid in filter(str.isdigit, os.listdir('/proc')):
        fds = []
        try:
            for fd in os.listdir(f'/proc/{pid}/fd'):
                try:
                    if os.readlink(f'/proc/{pid}/fd/{fd}').startswith('/dev/dri/'):
                        fds.append(fd)
                except OSError:
                    continue
        except OSError:
            continue
        if fds:
            found[pid] = tuple(fds)
    return found


def gpu_nsec(pid, fds):
    """Time (ns) the process spent on GPU engines, counted once per client. Only the fdinfo of
    DRM fds found by the scan is read (not all); if an fd was closed and reused for another
    file it has no drm-client-id and is not counted."""
    total, seen = 0, set()
    for fd in fds:
        try:
            text = Path(f'/proc/{pid}/fdinfo/{fd}').read_text()
        except OSError:
            continue
        client = re.search(r'drm-client-id:\s*(\d+)', text)
        if not client or client.group(1) in seen:
            continue
        seen.add(client.group(1))
        total += sum(int(v) for v in re.findall(r'drm-engine-[\w-]+:\s*(\d+) ns', text))
    return total


def pid_key(pid):
    try:
        cg = Path(Path(f'/proc/{pid}/cgroup').read_text().strip().split('::', 1)[1].lstrip('/'))
        key = app_key(CGROUP / cg)
        if key is None:
            stat = Path(f'/proc/{pid}/stat').read_text()
            key = 'terminal:' + stat[stat.index('(') + 1:stat.rindex(')')]
        return key
    except (OSError, IndexError):
        return 'system'


def screen_watts():
    """Estimated power of the laptop screen (0 if off): roughly linear with brightness."""
    for conn in PANEL.glob('card*-eDP-*'):
        if read(conn / 'dpms') != 'On':
            return 0.0
    for bl in Path('/sys/class/backlight').iterdir():
        try:
            return 0.4 + 3.6 * int(read(bl / 'brightness')) / int(read(bl / 'max_brightness'))
        except (TypeError, ValueError, ZeroDivisionError):
            continue
    return 0.0


class Usage:
    def __init__(self):
        self.prev = None          # previous sample: (time, {cgroup: usec}, {(pid, name): usec}, {pid: ns})
        self.gpu = {}             # pid → DRM fd numbers
        self.gpu_scan = 0
        self.dirty = False        # there are changes not yet written to disk
        try:
            self.data = json.loads(USAGE.read_text())
        except (OSError, ValueError):
            self.data = {}
        if not isinstance(self.data, dict):
            self.data = {}
        self.data.setdefault('charge', {'start': None, 'percent': None, 'wh': {}})
        self.data.setdefault('hourly', {})
        self.data.setdefault('baseline', {})   # day → lowest (power − screen), for the idle baseline
        self.was_mains = None

    def sample(self, now):
        cg_usec, proc_usec, gpu = {}, {}, {}
        for cg in leaf_cgroups():
            key = app_key(cg)
            if key is None:
                proc_usec.update(proc_cpu(cg))
            else:
                usec = cpu_usec(cg)
                if usec is not None:
                    cg_usec[cg] = (key, usec)
        if not self.gpu_scan or now - self.gpu_scan >= GPU_RESCAN:
            self.gpu_scan, self.gpu = now, gpu_pids()
        for pid, fds in self.gpu.items():
            gpu[pid] = gpu_nsec(pid, fds)
        return now, cg_usec, proc_usec, gpu

    @staticmethod
    def weights(prev, cur):
        """CPU + GPU time (s) of each key between two samples."""
        _, pcg, pproc, pgpu = prev
        _, ccg, cproc, cgpu = cur
        w = {}
        for cg, (key, usec) in ccg.items():
            if cg in pcg:
                w[key] = w.get(key, 0) + max(0, usec - pcg[cg][1]) / 1e6
        for (pid, comm), usec in cproc.items():
            if (pid, comm) in pproc:
                k = f'terminal:{comm}'
                w[k] = w.get(k, 0) + max(0, usec - pproc[(pid, comm)]) / 1e6
        for pid, ns in cgpu.items():
            if pid in pgpu and ns > pgpu[pid]:
                k = pid_key(pid)
                w[k] = w.get(k, 0) + (ns - pgpu[pid]) / 1e9
        return w

    def tick(self, mains, watts):
        now = time.monotonic()
        capacity = int(read(BAT / 'capacity', '0') or 0)
        if mains:
            self.prev = None      # on AC the battery is not used: do not measure (no cost either)
            self.was_mains = True
            return
        if self.was_mains or self.data['charge'].get('start') is None:
            start = self.data['charge']
            # charged and unplugged: new period ("since last charge")
            if start.get('start') is None or capacity >= (start.get('percent') or 0) + 10 or capacity >= 95:
                self.data['charge'] = {'start': datetime.now().strftime('%Y-%m-%dT%H:%M'), 'percent': capacity,
                                       'wh': {}}
        self.was_mains = False
        cur = self.sample(now)
        prev, self.prev = self.prev, cur
        if prev is None or watts is None or not 0 < now - prev[0] < 600:
            return
        weights = self.weights(prev, cur)
        hours = (now - prev[0]) / 3600
        total = max(0.0, -watts)
        screen = min(screen_watts(), total)
        rest = total - screen
        day = datetime.now().strftime('%Y-%m-%d')
        self.data['baseline'][day] = min(self.data['baseline'].get(day, rest), rest)
        base = min(min(self.data['baseline'].values()), rest)
        active = rest - base
        busy = sum(weights.values())
        energy = {'screen': screen * hours, 'system': base * hours}
        if busy < 0.5:
            energy['system'] += active * hours
        else:
            for key, sec in weights.items():
                energy[key] = energy.get(key, 0) + active * hours * sec / busy
        hour = datetime.now().strftime('%Y-%m-%dT%H')
        bucket = self.data['hourly'].setdefault(hour, {})
        charge = self.data['charge'].setdefault('wh', {})
        for key, wh in energy.items():
            if wh > 0:
                bucket[key] = round(bucket.get(key, 0) + wh, 5)
                charge[key] = round(charge.get(key, 0) + wh, 5)
        self.save()

    def save(self):
        """Mark as changed; flush() writes to disk."""
        self.dirty = True

    def flush(self):
        if not self.dirty:
            return
        self.dirty = False
        limit = (datetime.now() - timedelta(days=USAGE_DAYS)).strftime('%Y-%m-%dT%H')
        self.data['hourly'] = {h: v for h, v in self.data['hourly'].items() if h >= limit}
        self.data['baseline'] = {d: v for d, v in self.data['baseline'].items() if d >= limit[:10]}
        try:
            USAGE.parent.mkdir(parents=True, exist_ok=True)
            tmp = USAGE.with_suffix('.tmp')
            tmp.write_text(json.dumps(self.data, ensure_ascii=False))
            os.chmod(tmp, 0o644)
            tmp.replace(USAGE)
        except OSError as e:
            self.dirty = True
            log(f'could not write battery usage: {e}')


# ------------------------------------------------------------------ main loop

def main():
    if '--validate' in sys.argv:
        try:
            print(json.dumps(validate(json.load(sys.stdin)), ensure_ascii=False, indent=2))
        except CONFIG_ERRORS as e:
            print(f'Invalid settings: {e}', file=sys.stderr)
            sys.exit(1)
        return

    # when systemd stops the service (SIGTERM), write buffered history and battery usage to disk
    def stop(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    profile = Profile()
    try:
        uevents = Uevents()
        profile.live = True
    except OSError as e:
        uevents = None
        log(f'could not open uevent socket ({e}); AC and profile will be read every round')
    mains = on_mains()
    auto, alerts, usage, unplugged = Auto(mains, profile), Alerts(), Usage(), Unplugged()
    guard = VoltageGuard()
    meter = EnergyMeter()
    # settings are read in the loop (when mtime changes); defaults at first
    config, config_mtime = json.loads(json.dumps(DEFAULT)), object()
    never = float('-inf')
    last_history = last_prune = last_fan = last_fault = last_estimate = never
    last_flush = time.monotonic()
    mains_dirty = False   # with the uevent socket: AC must be read again
    hot = False
    # driver already there at start: let tuned re-apply once (see tuned_reload)
    reload_at, reload_tries = (time.monotonic() + 3, 0) if PLATFORM_PROFILE.exists() else (0, 0)
    log('started')
    try:
        while True:
            try:
                mtime = CONFIG.stat().st_mtime if CONFIG.exists() else None
                if mtime != config_mtime:
                    config_mtime, config = mtime, load_config()
                    log(f"settings: automatic {'on' if config['enabled'] else 'off'}")
                now = time.monotonic()
                history_due = now - last_history >= HISTORY_EVERY
                # AC is read at most once per round; with the socket only when events were lost and on record
                if uevents is None or mains_dirty or history_due:
                    mains, mains_dirty = on_mains(), False
                unplugged.note(mains)
                if QC71.exists() and auto.busy(config):
                    auto.tick(config, mains)
                else:
                    # when off do not touch the EC; do not re-apply needlessly once turned on
                    auto.mains, auto.reapply_at = mains, 0
                if guard.due(history_due):
                    guard.tick(mains, alerts)
                temp = cpu_temp()
                hot = temp is not None and temp >= HOT_C
                if history_due:
                    last_history = now
                    # fan speed: on AC the energy does not come from the battery, read every minute
                    # for the chart (~39 interrupts/min); on battery every 5 min, when warm (≥60 °C)
                    # again every minute
                    rpm = None
                    if mains or (temp is not None and temp >= FAN_WARM_C) or now - last_fan >= FAN_EVERY_BATTERY:
                        last_fan, rpm = now, fan_rpm()
                    fault = None
                    if (temp is not None and temp >= FAULT_HOT_C) or now - last_fault >= FAULT_EVERY:
                        last_fault, fault = now, read(QC71 / 'fan_fault') == '1'
                    full, design = battery_wh()
                    watts = battery_watts()
                    usage.tick(mains, watts)
                    meter.tick(read(BAT / 'status'), watts, guard.config['sleep_volts'])
                    record([datetime.now().strftime('%Y-%m-%dT%H:%M:%S'), '1' if mains else '0',
                            read(BAT / 'capacity', ''), fmt(watts, '.2f'), fmt(temp), fmt(rpm, 'd'),
                            profile.get() or '', fmt(full, '.2f'), fmt(design, '.2f')])
                    alerts.check(temp, rpm, full, design, fault)
                    if now - last_estimate >= ESTIMATE_EVERY:
                        last_estimate = now
                        write_estimate()
                    if now - last_prune >= 86400:
                        last_prune = now
                        prune()
                elif temp is not None and temp >= 95:
                    alerts.check(temp)
                if now - last_flush >= FLUSH_EVERY:
                    last_flush = now
                    flush_history()
                    usage.flush()
                if reload_at and now >= reload_at:
                    if PLATFORM_PROFILE.exists() and tuned_reload():
                        log('tuned profile re-applied for the driver')
                        reload_at = 0
                        profile.dirty = True
                    else:
                        reload_tries += 1
                        reload_at = now + 5 if reload_tries < TUNED_RELOAD_TRIES else 0
            except Exception as e:  # keep the service alive
                log(f'error: {e!r}')

            # wait for the next round: normal round, history record or re-apply after an AC change
            deadline = min(time.monotonic() + (TICK_HOT if hot else TICK), last_history + HISTORY_EVERY)
            if auto.reapply_at:
                deadline = min(deadline, auto.reapply_at)
            if reload_at:
                deadline = min(deadline, reload_at)
            deadline = max(deadline, time.monotonic() + 1)   # do not spin even if the round fails
            if uevents is None:
                time.sleep(max(0, deadline - time.monotonic()))
                continue
            try:
                while (left := deadline - time.monotonic()) > 0:
                    ev = uevents.wait(left)
                    if ev.get('profile'):
                        profile.dirty = True
                    if ev.get('driver'):   # driver (re)loaded: tuned re-applies its profile shortly
                        reload_at, reload_tries = time.monotonic() + 2, 0
                        break
                    if ev.get('lost'):
                        profile.dirty = mains_dirty = True
                    if 'mains' in ev:
                        if ev['mains'] is None:
                            mains_dirty = True
                        else:
                            mains = ev['mains']
                    if 'mains' in ev or ev.get('lost'):
                        break   # AC changed: let the automatic profile react right away
            except OSError as e:
                log(f'uevent socket failed ({e}); AC and profile will be read every round')
                uevents, profile.live = None, False
    finally:
        signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGINT})
        flush_history()
        usage.flush()
        log('stopped')


if __name__ == '__main__':
    main()
