# Faster login on battery. The battery profile turns turbo off, which makes GNOME Shell start
# about twice as slow (measured: 3.9 s vs 2.2 s in a headless shell). When a user logs in on
# battery with turbo off, turbo is allowed for BOOST_S seconds, then tuned re-applies its profile.
# Started by systemd for each user manager (user@.service drop-in), argument: UID.
set -u

BOOST_S=20
NO_TURBO=/sys/devices/system/cpu/intel_pstate/no_turbo

uid=${1:-0}
# regular users only (not root, the login screen or other system users)
[[ "$uid" =~ ^[0-9]+$ ]] && [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || exit 0
for ac in /sys/class/power_supply/*; do
    [ "$(cat "$ac/type" 2>/dev/null)" = Mains ] && [ "$(cat "$ac/online" 2>/dev/null)" = 1 ] && exit 0
done
[ "$(cat "$NO_TURBO" 2>/dev/null)" = 1 ] || exit 0

declare -A epp
for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    epp[$f]=$(cat "$f")
done
restore() {
    # tuned owns these values: let it apply its current profile (keeps the automatic mode)
    if ! busctl call --timeout=25 com.redhat.tuned /Tuned com.redhat.tuned.control reload >/dev/null 2>&1; then
        echo 1 > "$NO_TURBO"
        for f in "${!epp[@]}"; do echo "${epp[$f]}" > "$f"; done
    fi
}
trap 'restore; exit 0' TERM INT

echo 0 > "$NO_TURBO" || exit 0
for f in "${!epp[@]}"; do echo balance_performance > "$f" 2>/dev/null; done
echo "login on battery: turbo allowed for ${BOOST_S} s"
sleep "$BOOST_S" &
wait $!
restore
echo "login boost over, power profile re-applied"
